<!-- ════════════════════════════════════════════════════════════════
     U.S. POP HEALTH MULTI-LENS MAP — v2, on the HU full-map standard
     (docs/HU-UI-GRAMMAR.md §5b). Promoted from the lens-v2 pilot
     2026-07-19; the D3 v1 lives in archive/multi-lens-map-2026-07-19-d3-v1.html.
     Identity preserved: metricsConfig + stateData + dataYears inlined at
     build (same machinery, same numbers), TREND_CONFIG year model ported
     verbatim (history is estimated, labeled est.). The new canvas buys
     real county boundaries, basemap context, GPS find-my-county, and the
     kit sheet. Old ?lens/?metric/?state links still resolve.
════════════════════════════════════════════════════════════════ -->
<!-- Build-time data as DATA, not executable script. The module parses these and
     republishes them on window under the same names, so the tool logic is unchanged.
     A non-executable script type does not need 'unsafe-inline' in the CSP. -->
<script type="application/json" id="mlm-lens-config">{{ metricsConfig | dump | safe }}</script>
<script type="application/json" id="mlm-state-data">{{ stateData | dump | safe }}</script>
<script type="application/json" id="mlm-data-years">{{ dataYears | dump | safe }}</script>
{% raw %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/maplibre-gl@5.6.0/dist/maplibre-gl.css">
<style>
.vh { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }
.lv-shell { position:relative; height:calc(100dvh - 64px); overflow:hidden; }
#lvMap { position:absolute; inset:0; }
.lv-top { position:absolute; top:10px; left:10px; right:10px; z-index:20; display:flex; flex-direction:column; gap:8px; pointer-events:none; }
.lv-top > * { pointer-events:auto; }
.lv-srow { display:flex; gap:8px; align-items:center; }
.lv-ident { flex:none; display:flex; align-items:center; height:38px; padding:0 13px; border-radius:10px;
  background:color-mix(in srgb, var(--surface) 94%, transparent); border:1px solid var(--border2);
  font-family:var(--display); font-size:12.5px; font-weight:700; color:var(--t2); backdrop-filter:blur(8px); white-space:nowrap; }
.lv-ident b { color:var(--teal); margin-left:4px; }
[data-theme="light"] .lv-ident b { color:var(--teal-ink); }
/* The ident was switched off entirely, leaving a 1px visually-hidden h1 as the only
   thing naming this tool on a phone. Keep the short half of the name. */
@media (max-width:699px){
  .lv-ident { display:inline-flex; align-items:center; font-size:11px; padding:0 8px; flex:none; }
  .lv-ident .lv-ident-long { display:none; }
}
.lv-metric { flex:1; max-width:460px; display:flex; align-items:center; gap:9px; height:38px; padding:0 14px; border-radius:999px;
  background:color-mix(in srgb, var(--surface) 94%, transparent); border:1px solid var(--teal);
  color:var(--t1); font-family:var(--font); font-size:12.5px; font-weight:600; cursor:pointer; backdrop-filter:blur(8px);
  box-shadow:0 4px 16px rgba(0,0,0,.35); text-align:left; overflow:hidden; }
/* teal border = tappable, same control language as the scope chip. The pill
   is the tool's PRIMARY selector; it must not dress like the inert ident pill */
[data-theme="light"] .lv-metric { border-color:var(--teal-dk); }
.lv-metric svg { width:14px; height:14px; stroke-width:1.75; color:var(--teal); flex:none; }   /* the Lucide metric icon sizes like the site selector grammar (was the 📊 emoji) */
[data-theme="light"] .lv-metric svg { color:var(--teal-dk); }
.lv-metric:hover { border-color:var(--teal); box-shadow:0 4px 16px rgba(0,0,0,.35); }
.lv-metric:active { transform:scale(.985); }
.lv-metric .mq { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.lv-metric .yr { margin-left:auto; flex:none; font-family:var(--mono); font-size:9.5px; color:var(--t3); }
/* the caret says "this opens the drawer": the pill is the READOUT, the
   drawer's Display tab is the editor (nav lives left, view lives right).
   It sits in a teal well now so it reads as the pill's handle, not decor */
.lv-metric .car { flex:none; width:22px; height:22px; margin-right:-4px; border-radius:50%;
  display:flex; align-items:center; justify-content:center; font-size:9px;
  background:color-mix(in srgb, var(--teal) 20%, transparent); color:var(--teal); }
[data-theme="light"] .lv-metric .car { color:var(--teal-ink); background:color-mix(in srgb, var(--teal) 26%, transparent); }
/* one-time coach: teaches "the pill opens the catalog," then leaves forever
   (budget rule: guidance leaves after use). ?coach in the URL re-arms it. */
.lv-coach { align-self:flex-end; position:relative; margin:-1px 48px 0 0;
  border:1px solid var(--teal); background:var(--surface); color:var(--t1);
  font-family:var(--font); font-size:12px; font-weight:600; padding:8px 12px;
  border-radius:10px; box-shadow:0 8px 26px rgba(0,0,0,.45); cursor:pointer; }
.lv-coach::before { content:''; position:absolute; top:-5px; right:26px; width:8px; height:8px;
  background:var(--surface); border-left:1px solid var(--teal); border-top:1px solid var(--teal); transform:rotate(45deg); }
[data-theme="light"] .lv-coach, [data-theme="light"] .lv-coach::before { border-color:var(--teal-dk); }
.lv-coach.gone { opacity:0; transition:opacity .3s; pointer-events:none; }
@keyframes lv-coach-pulse { 50% { background:var(--teal); color:#062024; } }
.lv-metric.coaching .car { animation:lv-coach-pulse 1.7s ease-in-out 3; }
@media (prefers-reduced-motion:reduce){ .lv-metric.coaching .car { animation:none; } }
/* the view group parks RIGHT, stacked over the drawer it opens */
.lv-viewgrp { margin-left:auto; display:flex; gap:8px; align-items:center; flex:1; max-width:560px; justify-content:flex-end; }
/* ‹ › steppers flank the pill: shuffle one metric per tap, no drawer round-trip */
.lv-mstep { flex:none; width:34px; height:38px; border-radius:999px; cursor:pointer; padding:0;
  background:color-mix(in srgb, var(--surface) 94%, transparent); border:1px solid var(--border2);
  color:var(--t2); font-size:16px; line-height:1; backdrop-filter:blur(8px); box-shadow:0 4px 16px rgba(0,0,0,.35); }
.lv-mstep:hover { color:var(--teal); border-color:var(--teal); }
/* the metric browser lives IN the Display tab now (grammar A, round two:
   David's call, no filter on one side and display on the other) */
#lvDisplayBody .lv-find { padding:0 0 8px; }
#lvDisplayBody .lv-find input { width:100%; height:34px; border-radius:8px; border:1px solid var(--border2);
  background:var(--raised); color:var(--t1); font-family:var(--font); font-size:13px; padding:0 10px; }
#lvDisplayBody .lv-find input:focus { outline:none; border-color:var(--teal); }
#lvMetricList { max-height:44vh; overflow-y:auto; }
#lvMetricList .pop-opt { width:100%; display:flex; align-items:center; gap:8px; text-align:left; }
#lvMetricList .pop-opt .mn { flex:1; min-width:0; }
/* ◯ Size / ☆ Pin: LABELED chips now, not lone glyphs (David 2026-07-26,
   "something people can understand"). Same words the This-view block and
   the cards already use, so the vocabulary teaches itself. Bordered =
   button, blue = overlay-on, amber = pinned. On = solid ink, never a wash
   (The Ink State Rule); hue stays semantic, blue for overlay, amber for pin. */
#lvMetricList .ovbtn, #lvMetricList .pinbtn { flex:none; display:inline-flex; align-items:center;
  font-family:var(--mono); font-size:10.5px; white-space:nowrap; color:var(--t2);
  padding:5px 10px; border-radius:999px; border:1px solid var(--border2); background:var(--raised); }
#lvMetricList .ovbtn:hover { color:var(--blue-hi); border-color:var(--blue-hi); }
#lvMetricList .ovbtn.on { color:#fff; border-color:var(--blue); background:var(--blue); font-weight:700; }
#lvMetricList .pinbtn:hover { color:var(--amber); border-color:var(--amber); }
#lvMetricList .pinbtn.on { color:#062024; border-color:var(--amber); background:var(--amber); font-weight:700; }
/* coarse pointers: the pair keeps the touch floor, labels and all */
@media (hover:none){
  #lvMetricList .ovbtn, #lvMetricList .pinbtn { min-height:44px; padding:0 12px; font-size:11px; }
}
/* light: amber as TEXT drops to the deep step; the solid .on fill keeps its
   #062024 ink (passes on both themes), so only the resting hover flips */
[data-theme="light"] #lvMetricList .pinbtn:hover:not(.on) { color:var(--amber-dk); border-color:var(--amber-dk); }
#lvMetricList .pop-opt .grain { font-family:var(--mono); font-size:10px; color:var(--t2); margin-left:8px; }
#lvMetricList .pop-opt .lns { font-family:var(--mono); font-size:10px; color:var(--teal); margin-left:8px; }
[data-theme="light"] #lvMetricList .pop-opt .lns { color:var(--teal-ink); }
#lvMetricList .lv-none { font-family:var(--mono); font-size:11px; color:var(--t2); padding:12px 8px; }
/* catalog rows lead with a survey marker: ▸ at rest, ◆ on the picked row
   (wayfinding by glyph, quieter than any border) */
#lvMetricList .pop-opt .mn::before { content:'▸ '; color:var(--t4); }
#lvMetricList .pop-opt[aria-selected="true"] .mn::before { content:'◆ '; color:var(--teal); }
#lvMetricList .pop-opt[aria-selected="true"] .mn { font-weight:700; color:var(--t1); }
[data-theme="light"] #lvMetricList .pop-opt[aria-selected="true"] .mn::before { color:var(--teal-dk); }
/* chrome grammar A: one bar, one drawer (Details|Display), one cluster. */
.lv-tabs { display:flex; gap:4px; background:var(--raised); border-radius:9px; padding:3px; margin:4px 0 10px; flex:none; }
.lv-tabs button { flex:1; border:1px solid transparent; background:none; border-radius:7px; padding:6px 0;
  font-family:var(--font); font-size:11.5px; font-weight:700; color:var(--t3); cursor:pointer; }
.lv-tabs button.on { background:var(--surface); border-color:var(--border2); color:var(--t1); }
#lvDisplayBody { overflow-y:auto; min-height:0; flex:1; }
.lv-dsec { border-bottom:1px dotted var(--border); padding:12px 0; }
.lv-dsec:last-child { border-bottom:none; }
/* section headers you can actually read (David's call): display face leads,
   the mono meta rides right as a suffix */
.lv-dsec h5 { display:flex; align-items:baseline; gap:8px; margin:0 0 8px;
  font-family:var(--display); font-size:13.5px; font-weight:800; color:var(--t1); }
.lv-dsec h5 .sub { margin-left:auto; font-family:var(--mono); font-size:10.5px; font-weight:400;
  letter-spacing:.08em; text-transform:uppercase; color:var(--t2); }
.lv-drow { display:flex; gap:6px; flex-wrap:wrap; }
/* "This view": the whole composition stated in words, definition included */
.lv-view .lv-vrow { display:flex; align-items:baseline; gap:8px; padding:2px 0; }
.lv-view .lv-vrow .role { flex:none; min-width:56px; font-family:var(--mono); font-size:9.5px;
  letter-spacing:.12em; text-transform:uppercase; color:var(--t2); }
.lv-view .lv-vrow b { font-size:13px; color:var(--t1); font-weight:700; }
.lv-view .lv-vdefn { font-size:11.5px; line-height:1.55; color:var(--t2); margin:2px 0 6px 64px; }
.lv-view .lv-vdefn .src { display:block; font-family:var(--mono); font-size:10px; color:var(--t2); margin-top:3px; }
.lv-tgl { display:flex; justify-content:space-between; align-items:center; padding:6px 2px; font-size:12.5px; color:var(--t2); }
.lv-sw { width:34px; height:19px; border-radius:999px; background:var(--raised2); border:1px solid var(--border2); position:relative; cursor:pointer; flex:none; }
.lv-sw::after { content:''; position:absolute; left:2px; top:2px; width:13px; height:13px; border-radius:50%; background:var(--t3); transition:left .15s; }
.lv-sw.on { background:var(--teal); border-color:var(--teal); }
.lv-sw.on::after { left:17px; background:#062024; }
.lv-status { position:absolute; bottom:88px; left:50%; transform:translateX(-50%); z-index:20; white-space:nowrap;
  font-family:var(--mono); font-size:10.5px; color:var(--t2); padding:6px 12px; border-radius:999px;
  background:color-mix(in srgb, var(--surface) 94%, transparent); border:1px solid var(--border2);
  backdrop-filter:blur(8px); transition:opacity .3s; }
.lv-status.done { opacity:0; pointer-events:none; }
.lv-cleg { position:absolute; bottom:34px; left:10px; z-index:20; display:flex; align-items:center; gap:3px;
  padding:5px 9px; border-radius:999px; background:color-mix(in srgb, var(--surface) 94%, transparent);
  border:1px solid var(--border2); backdrop-filter:blur(8px); }
.lv-cleg i { width:14px; height:8px; border-radius:2px; }
.lv-cleg span { font-family:var(--mono); font-size:9px; color:var(--t2); margin:0 4px; }
/* MapLibre's attribution chip ships light-only from the CDN css. Theme it */
[data-theme="dark"] .maplibregl-ctrl-attrib { background:color-mix(in srgb, var(--surface) 88%, transparent) !important; }
[data-theme="dark"] .maplibregl-ctrl-attrib, [data-theme="dark"] .maplibregl-ctrl-attrib a { color:var(--t2) !important; }
[data-theme="dark"] .maplibregl-ctrl-attrib-button { filter:invert(1); }

/* AK/HI insets: same corner boxes as the operations map, stacked above the
   legend. Here each box IS the state's choropleth swatch for the live metric. */
.lv-insets { position:absolute; left:10px; bottom:64px; z-index:20; display:flex; gap:8px; transition:opacity .2s; }
.lv-insets.hide { opacity:0; pointer-events:none; }
.lv-inset { position:relative; width:120px; height:92px; padding:0; border-radius:10px; overflow:hidden; cursor:pointer;
  border:1px solid var(--border2); background:var(--surface); box-shadow:0 4px 16px rgba(0,0,0,.35); }
.lv-inset:hover { border-color:var(--teal); }
.lv-inset .lv-inset-map { position:absolute; inset:0; display:block; pointer-events:none; }
.lv-inset b { position:absolute; top:5px; left:7px; z-index:2; font-family:var(--mono); font-size:9.5px; font-weight:600;
  color:var(--t1); background:color-mix(in srgb, var(--surface) 88%, transparent); border:1px solid var(--border);
  border-radius:6px; padding:2px 6px; }
.lv-inset b span { color:var(--teal); }
[data-theme="light"] .lv-inset b span { color:var(--teal-ink); }
@media (max-width:699px){ .lv-insets { display:none; } }   /* phone portrait already frames AK+HI; GL contexts are precious there */
/* the legend and the control bar both sat at bottom:34px, and the bar wins on
   z-index, so the worse-to-better key was 6px tall at 360. Lift it clear. */
@media (max-width:699px){ .lv-cleg { bottom:84px; } }
/* year + rankings + locate: ONE thumb-zone cluster, bottom center (David's
   call 2026-07-26: the GPS button lives with its siblings, not in a corner).
   The FAB drops its corner-float positioning and rides the row in-flow. */
.lv-bottombar { position:absolute; bottom:34px; left:50%; transform:translateX(-50%); z-index:110; display:flex; gap:8px; }
.lv-bottombar .hu-fab { position:static; width:42px; height:42px; flex:none; box-shadow:0 6px 20px rgba(0,0,0,.45); }
.lv-yearpill { display:flex; align-items:center; height:42px; padding:0 6px; border-radius:999px;
  background:var(--surface); border:1px solid var(--border2); box-shadow:0 6px 20px rgba(0,0,0,.45); }
.lv-yearpill button { width:34px; height:34px; border:none; background:none; color:var(--t2); font-size:17px; cursor:pointer; border-radius:50%; }
.lv-yearpill button:hover { color:var(--teal); background:var(--raised); }
.lv-yearpill button:disabled { opacity:.3; cursor:default; }
.lv-yearpill span { font-family:var(--mono); font-size:11.5px; font-weight:600; color:var(--t1); min-width:74px; text-align:center; }
.lv-yearpill span i { font-style:normal; color:var(--amber); }
[data-theme="light"] .lv-yearpill span i { color:var(--amber-dk); }
.lv-yearpill.no-trend { opacity:.5; }
.lv-rankbtn { height:42px; padding:0 18px; border-radius:999px; cursor:pointer;
  background:var(--surface); border:1px solid var(--border2); color:var(--t1);
  font-family:var(--font); font-size:12.5px; font-weight:700; box-shadow:0 6px 20px rgba(0,0,0,.45); }
.lv-rankbtn:hover { border-color:var(--teal); }
.lv-trend { margin-top:12px; }
.lv-spark { width:100%; max-width:260px; height:54px; display:block; }
.lv-trend-lbl { font-family:var(--mono); font-size:10px; color:var(--t2); margin-top:4px; line-height:1.5; }
.lv-actions { margin-top:12px; display:flex; gap:8px; flex-wrap:wrap; }
.lv-rank-row b { font-family:var(--mono); font-size:10px; color:var(--t3); margin-right:8px; }
@media (max-width:1099px){
  .lv-shell:has(#lvSheet.open) .lv-bottombar { bottom:150px; }   /* the FAB rides the bar now */
}
.lv-scope { flex:none; height:38px; padding:0 13px; border-radius:999px; cursor:pointer;
  background:color-mix(in srgb, var(--surface) 94%, transparent); border:1px solid var(--teal);
  color:var(--t1); font-family:var(--font); font-size:12px; font-weight:700; backdrop-filter:blur(8px);
  white-space:nowrap; max-width:40vw; overflow:hidden; text-overflow:ellipsis; box-shadow:0 4px 16px rgba(0,0,0,.35); }
[data-theme="light"] .lv-scope { border-color:var(--teal-dk); }
#lvSheet { padding:0 16px calc(14px + env(safe-area-inset-bottom)); z-index:300; }
#lvSheet:not(.open) { transform:translateY(105%); }
/* survey ticks, local copy: .shell-sheet::before is the kit's grabber
   fallback, so the drawer carries its two corner ticks as <i> elements
   (The Survey Tick Rule: 10px arms, border gray, never accent) */
.lv-tick { position:absolute; width:10px; height:10px; pointer-events:none; z-index:2;
  top:5px; left:5px; border-top:1px solid var(--border2); border-left:1px solid var(--border2); }
.lv-tick.b { top:auto; left:auto; bottom:5px; right:5px; border-top:none; border-left:none;
  border-bottom:1px solid var(--border2); border-right:1px solid var(--border2); }
.lv-x { position:absolute; top:10px; right:10px; z-index:2; }
.lv-kicker { font-family:var(--mono); font-size:9.5px; letter-spacing:.12em; text-transform:uppercase; color:var(--teal); }
[data-theme="light"] .lv-kicker { color:var(--teal-ink); }
/* drawer-card names run the cartographic variant: tracked caps at drawer
   scale (state, county and compare names all clear the ~40-char line) */
.lv-name { display:flex; align-items:baseline; gap:10px; font-family:var(--display); font-size:14px; font-weight:800;
  text-transform:uppercase; letter-spacing:.09em; color:var(--t1); line-height:1.15; padding-right:34px; }
/* the peek payoff: value rides the name row, rank leads the sub, but only
   where the sheet PARKS at peek (<1100). The desktop dock shows the full
   ptable already; a duplicate header stat would just be noise there. */
.lv-name .pv { display:none; margin-left:auto; flex:none; font-size:15px; color:var(--teal);
  text-transform:none; letter-spacing:normal; font-variant-numeric:tabular-nums; }   /* the VALUE keeps its own case */
[data-theme="light"] .lv-name .pv { color:var(--teal-ink); }
@media (max-width:1099px){ .lv-name .pv { display:inline; } }
@media (min-width:1100px){ .lv-sub .pr { display:none; } }
/* readable sub text (David's call): brighter tier + a size up, drawer-wide */
.lv-sub { font-family:var(--mono); font-size:11.5px; color:var(--t2); margin:3px 0 12px; }
#lvSheet .hu-stat .k { font-size:10px; color:var(--t2); }
/* the primary table (David's spec): rows = Value/Rank/Population, columns =
   the two geographies. One glance, one structure, every card the same. */
.lv-ptable { display:grid; grid-template-columns:auto 1fr 1fr; border:1px solid var(--border); border-radius:10px; overflow:hidden; }
.lv-ptable > div { padding:9px 12px; border-bottom:1px solid var(--border); }
.lv-ptable > div:nth-last-child(-n+3) { border-bottom:none; }
.lv-ptable .th { background:var(--raised); font-family:var(--mono); font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:var(--t2); }
.lv-ptable .rl { font-family:var(--mono); font-size:9.5px; letter-spacing:.12em; text-transform:uppercase; color:var(--t2); align-self:center; }   /* mono caption (The Caption Rule, Fog Blue ink) */
.lv-ptable .val { font-family:var(--display); font-size:17px; font-weight:800; color:var(--t1); }
.lv-ptable .val.sm { font-size:14px; font-weight:700; }
.lv-ptable .val span { font-family:var(--mono); font-size:10.5px; font-weight:400; color:var(--t2); margin-left:4px; }
.lv-ptable .hi { color:var(--teal); } .lv-ptable .lo { color:var(--amber); }
[data-theme="light"] .lv-ptable .hi { color:var(--teal-ink); }
[data-theme="light"] .lv-ptable .lo { color:var(--amber-dk); }
/* secondary metrics fold behind one switch. Average users see the primary
   story; the toggle opens the ◯/★ depth */
.lv-more { margin-top:12px; }
.lv-more .hu-stats { margin-top:8px; }
.lv-rows { overflow-y:auto; min-height:0; flex:1; }
.lv-rows .pop-opt { width:100%; }
.lv-msec { font-family:var(--mono); font-size:9.5px; letter-spacing:.12em; text-transform:uppercase; color:var(--t3); padding:10px 4px 4px; }
.lv-src { font-family:var(--mono); font-size:11px; color:var(--t2); margin-top:12px; line-height:1.6; }
@media (min-width:1100px){
  /* the drawer tracks the RESIZABLE width (monitor yes, phone no, David's
     call). The locate FAB left this corner for the bottom-center cluster. */
  #lvSheet { left:auto; right:12px; bottom:12px; top:124px; width:var(--drawer-w, 370px);
    border:1px solid var(--border2); border-radius:14px; height:auto; max-height:none; }
  #lvSheet.dt-peek, #lvSheet.dt-half, #lvSheet.dt-full { height:auto; max-height:calc(100dvh - 200px); overflow-y:auto; }
  /* Display = the workbench: a pin adds a "This view" row, and height:auto
     would grow the whole drawer under the cursor mid-multi-select. While
     the Display tab is up the drawer just holds its full working height. */
  #lvSheet.tab-display.dt-peek, #lvSheet.tab-display.dt-half, #lvSheet.tab-display.dt-full { height:calc(100dvh - 200px); }
  #lvSheet:not(.open) { transform:translateX(115%); }
  #lvSheet .hu-sheet-grab { display:none; }
  #lvSheet { padding-top:12px; }
  #lvSheet .lv-resize { display:block; position:absolute; left:-4px; top:0; bottom:0; width:9px; cursor:ew-resize; z-index:5; }
  #lvSheet .lv-resize:hover { background:var(--teal); }   /* solid, not a gradient wash */
}
.lv-resize { display:none; }   /* phone/tablet: the sheet owns its width */
/* ── PHONE (≤699): stacked chrome + 44px thumb targets (QA 2026-07-25) ──
   One row could not hold scope + ‹ pill › on a 400px screen. The pill ran
   off the edge. Scope takes row one, the metric group takes row two, and
   every control in reach of a thumb clears the 44px floor. The FAB rises
   over the collapsed ⓘ attribution chip parked in the corner below it. */
@media (max-width:699px){
  .lv-srow { flex-wrap:wrap; }
  .lv-viewgrp { flex-basis:100%; max-width:none; min-width:0; }
  .lv-scope { height:44px; font-size:13px; max-width:70vw; }
  .lv-metric { height:44px; font-size:13px; min-width:0; }
  .lv-mstep { width:44px; height:44px; }
  .lv-yearpill { height:46px; }
  .lv-yearpill button { width:42px; height:42px; }
  .lv-rankbtn { height:46px; }
  .lv-bottombar .hu-fab { width:46px; height:46px; }
}
</style>

