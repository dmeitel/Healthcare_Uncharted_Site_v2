/* The trail collapsed to 3.2px of 89, so the selected node was invisible. But that
   crush was also absorbing about 70px of toolbar overflow: capping it alone pushed the
   Views and Reset controls off the right edge with no scroll to recover them, since
   #tb is nowrap inside an overflow:hidden ancestor. So the bar wraps and the trail
   takes its own row, the shape the atlas and hospital toolbars already use.
   One height feeds both #tb and the canvas top so the two cannot drift apart.
   The reset control is a div[role=button], not a <button>, so an earlier
   "button.hi" selector matched nothing and it stayed 32x32. */
@media (max-width:699px){
  /* height must follow the content: at 360 the bar needs a THIRD row (118px, not 88),
     and a fixed height with align-content:center spilled it out both ends, dropping
     the crumb on top of the title where it could not be tapped. Both #tb and #ct are
     position:static here, so the canvas simply flows after the bar and the seam
     cannot drift. */
  #tb { flex-wrap:wrap; height:auto; row-gap:4px; }
  #bc { flex:1 0 100%; order:3; max-width:none; overflow-x:auto; scrollbar-width:none; }
  #bc::-webkit-scrollbar { display:none; }
  .hi { min-width:44px; min-height:44px; }
