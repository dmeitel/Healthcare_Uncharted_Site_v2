/* ── MOBILE / TABLET  ≤ 768px ───────────────────────────── */
@media (max-width: 699px) {
  /* ── Structural: let page scroll naturally ── */
  .lab-shell { padding: 0; }
  .lab-scaler { height: auto; min-height: 0; }
  #wrap {
    height: auto !important;
    overflow: visible !important;
    min-height: calc(100dvh - 64px);
  }
  #hf { display: none; }

  /* ── Panels: hide left, convert layout to column ── */
  #lp, #dh-l, #dh-r { display: none !important; }
  #svg-lines { display: none; }

  /* Inner topbar: static so page scrolls past it */
  #tb { position: static; }

  /* Content area: flow after #tb */
  #ct {
    position: static;
    display: flex;
    flex-direction: column;
    overflow: visible;
    height: auto;
  }

  /* Main area: natural height, normal scroll */
  #ma {
    overflow: visible !important;
    touch-action: auto !important;
    height: auto !important;
    flex: none;
    margin: 0;
    background: none;
  }
  #ma-inner {
    min-width: 0 !important;
    width: 100%;
    transform: none !important;
  }
  .pz-reset-btn, .pz-hint { display: none !important; }

  /* ── Title block: compact ── */
  #tblk { padding: 8px 14px 6px; }
  .tt { font-size: 16px; }
  .tsub { display: none; }

  /* ── Layer rows: vertical stack ── */
  .lr {
    flex-direction: column;
    padding-block: 0 !important;
    min-height: 0;
    border-radius: 4px;
    margin: 0 0 4px;
    overflow: visible;
  }

  /* ── Layer label: compact horizontal header ── */
  .ll {
    width: 100%;
    flex-direction: row;
    align-items: center;
    padding: 8px 12px 8px 14px;
    border-right: none !important;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    min-height: 0;
    gap: 10px;
  }
  .ll-top { margin-bottom: 0; }
  .ll-icon { width: 28px; height: 28px; font-size: 15px; }
  .lt { text-align: left; font-size: 12px; }
  .lsu { display: none; }
  .ln { display: none; }

  /* ── Node area: horizontal scroll strip ── */
  .lnd {
    flex-direction: row;
    flex-wrap: nowrap;
    overflow-x: auto;
    overflow-y: visible;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x;
    padding: 10px 12px 12px !important;
    gap: 10px;
    align-items: center;
  }
  .lnd::-webkit-scrollbar { height: 2px; }
  .lnd::-webkit-scrollbar-thumb { background: rgba(78,205,196,0.22); border-radius: 2px; }

  .nc {
    flex-shrink: 0;
    width: 108px;
    min-height: 76px;
    font-size: 12px;
    padding: 8px 10px 16px;
  }
  .na { flex-shrink: 0; }

  /* Sub-map inline row */
  .sml-inner { padding: 10px 12px; gap: 8px; }
  .sml .nc { flex-shrink: 0; width: 100px; min-height: 68px; }
  .sml-lbl { min-width: 100px; font-size: 9px; padding-right: 12px; }

  /* ── Right panel: fixed bottom sheet ── */
  #rp {
    position: fixed !important;
    bottom: 0; left: 0; right: 0;
    width: auto !important;
    display: flex; flex-direction: column;
    transform: translateY(105%);
    transition: transform .28s cubic-bezier(.2,.8,.2,1), max-height .2s ease, height .2s ease;
    padding-bottom: env(safe-area-inset-bottom);
    z-index: 200;
    border-left: none !important;
    border-right: none !important;
    border-top: 2px solid rgba(78,205,196,0.45);
    border-radius: 0;
    margin: 0;
    background: #060E1C;
  }
  /* Detent contract, so HUKit.sheet drives this panel instead of a hand-rolled
     height animation. dt-peek/half/full mirror the kit's own numbers; the slide is
     transform, which is both the CSS rule (never animate a layout property) and the
     only version that composites. */
  #rp.open { transform: translateY(0); }
  #rp.dt-peek { max-height: 120px; overflow: hidden; }
  #rp.dt-half { max-height: 52vh; max-height: 52dvh; overflow-y: auto; }
  #rp.dt-full { height: 92vh; height: 92dvh; max-height: 92vh; max-height: 92dvh; overflow-y: auto; }
  #rp.dragging { transition: none !important; }
  [data-theme="light"] #rp { background: #f0f7ff; }
  #rpMobClose { display: flex !important; }
}

/* ── Pinch-zoom UI (shared) ─────────────────────────────── */
.pz-reset-btn {
  position: absolute; bottom: 14px; left: 50%;
  transform: translateX(-50%); z-index: 90;
  display: none; align-items: center; gap: 6px;
  background: rgba(8,20,44,0.9); border: 1px solid rgba(78,205,196,0.55);
  color: rgba(78,205,196,0.92); padding: 7px 18px;
  border-radius: 20px; font-size: 11px;
  font-family: var(--mono);
  cursor: pointer; white-space: nowrap;
  backdrop-filter: blur(10px);
}
.pz-hint {
  position: absolute; bottom: 50px; left: 50%;
  transform: translateX(-50%); z-index: 90;
  pointer-events: none; display: none; white-space: nowrap;
  background: rgba(8,20,44,0.85); border: 1px solid rgba(78,205,196,0.3);
  border-radius: 16px; padding: 5px 14px;
  font-size: 10px; letter-spacing: .04em;
  color: rgba(78,205,196,0.82);
  font-family: var(--mono);
  transition: opacity 0.8s ease;
}

/* Shared attribution strip: slimmer + tucked into the shell's bottom padding
   so it clears the frame corner bracket and the right panel's bottom edge */
.tool-attribution--fixed{bottom:4px;right:16px;padding:4px 10px}

/* ── FIELD INSTRUMENT chrome · Quiet Precision 2026-08-06 ──────
   The old accent ruler-tick strip under the toolbar retired; the
   masthead stands on its single 2px border2 rule. Tabular numerals
   and standard icon sizing stay. Scene palette untouched. */

/* instrument numerals: the right detail panel's stats read in tabular figures */
#rp{font-variant-numeric:tabular-nums}
/* the kit injects a drag grabber for the phone sheet; the desktop panel is docked */
@media (min-width:700px){ #rp .hu-sheet-grab{ display:none } }

/* standard icon sizing on the (static) control-section labels + reset buttons */
.rh svg{width:11px;height:11px;stroke-width:2;color:rgba(78,205,196,0.8);vertical-align:-1.5px;margin-right:5px}
[data-theme="light"] .rh svg{color:var(--teal-dk)}
.hi svg{width:16px;height:16px;stroke-width:1.75}
.pz-reset-btn svg{width:14px;height:14px;stroke-width:1.75;flex:none}

/* ── CONTROL ARCHITECTURE v2 · Layer selector + applied strip ──────
   The primitives (.selector/.selector-pop/.pop-opt/.applied-strip) live in
   hu-global.css; these rules only seat them in this tool's scene. */
.vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
#tb .selector{flex-shrink:0;max-width:210px}
/* #wrap * zeroes padding/margin at ID specificity, flattening the global
   primitives · re-seat their box model (values mirror hu-global.css) */
#tb .selector{padding:6px 11px}
#wrap .pop-head{padding:8px 10px}
#wrap .pop-head .icon-btn{margin-left:auto}
#wrap .selector-pop .pop-body{padding:6px}
#wrap .pop-sec{padding:10px 8px 4px}
#wrap .pop-opt{padding:7px 10px}
#wrap .applied-strip{padding:6px clamp(12px,2.5vw,20px)}
#wrap .applied-chip{padding:3px 4px 3px 11px}
@media (hover:none){
  #tb .selector{padding:10px 14px}
  #wrap .pop-opt{padding:11px 12px}
}
#as{position:absolute;top:52px;left:0;right:0;z-index:19;background:rgba(3,7,16,0.97);border-bottom:1px solid rgba(78,205,196,0.18)}
[data-theme="light"] #as{background:rgba(228,243,255,0.97);border-bottom-color:rgba(78,205,196,0.35)}
@media (max-width: 699px){
  #as{position:static} /* toolbar and content are static in the phone stack · the strip joins the flow */
  #tb .tool-bar-kicker{display:none} /* room for the Layer selector next to the breadcrumb */
}
</style>

