  .ac-sticky .cur { color:var(--blue-hi); font-weight:600; }
  .ac-sticky .asg { color:var(--teal); font-weight:600; }
  [data-theme="light"] .ac-sticky .asg { color:var(--teal-ink); }
  .ac-sticky .d-good { color:var(--green); font-weight:600; }
  /* amber, not red: this is the same overall difference the summary card and the answer show in
     amber, and one number on one screen should not wear two colours. The LEDGER keeps red/green,
     because there it means something else: this one category costs more or less. */
  .ac-sticky .d-bad { color:var(--amber); font-weight:600; }
  [data-theme="light"] .ac-sticky .d-good { color:var(--green-dk); }
  [data-theme="light"] .ac-sticky .d-bad  { color:var(--amber-dk); }
  /* one-row toolbar: kicker and crumb yield (atlas precedent) */
  .ac-shell .tool-bar-kicker, .ac-shell .tool-bar-crumb { display:none; }
  .ac-shell .tool-bar { gap:8px; }
  .ac-shell .tool-bar-title span { display:none; }  /* "Cost of Living" carries it; the row must not wrap */
  .ac-ask { padding:12px 14px; gap:10px 18px; }
  .ac-ask .ac-field { flex:1 1 140px; min-width:130px; }
  .ac-shell .shell-foot { padding-bottom:64px; }
}
