        </details>

        <details data-view="detail" class="ac-card hu-fold hu-fold--panel">
          <summary><i data-lucide="bed-double"></i>GSA per diem, new county<button type="button" class="hu-fold-note ac-badge" id="acPdBadge" hidden></button></summary>
