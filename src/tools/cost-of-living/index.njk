/* THE COMPARE ROW. The two places sit next to each other with the swap between them, the way
   a translator puts two languages, because the pair IS the question. The swap is a real button
   at the 44px floor, not an icon glued to a label. */
/* A GRID, so the swap sits between the two PLACES. When pay moved under each location the row
   became two lines, and a flex row aligned to its bottom edge put the arrow between the two PAY
   fields instead, which is not the comparison it swaps. Row 1 is the places and the arrow; row 2
   is each place's pay. display:contents lets each side's fields take grid cells directly. */
.ac-compare { display:grid; grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);
  column-gap:8px; row-gap:10px; align-items:end; flex:1 1 420px; min-width:0; }
.ac-compare-side { display:contents; }
.ac-compare-side:first-child > .ac-field { grid-column:1; }
.ac-compare-side:last-child > .ac-field { grid-column:3; }
.ac-compare-side > .ac-field:first-child { grid-row:1; }
.ac-compare-side > .ac-pay-annual, .ac-compare-side > .ac-pay-hourly { grid-row:2; }
.ac-compare > .ac-swap { grid-column:2; grid-row:1; }

/* THE VIEWS. The container's data-view picks which cards show; the answer card and the
