.ac-results[data-view="detail"]  .ac-results-inner > [data-view]:not([data-view="detail"]) { display:none; }
.ac-views { display:flex; gap:6px; flex-wrap:wrap; }

/* SUMMARY: the screenshot card. Everything a reader needs to trust the numbers (both places,
