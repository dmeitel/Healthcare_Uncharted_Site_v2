#acBars .up { fill:var(--amber); }
#acBars .down { fill:var(--dgm-line); }
#acBars .flat { fill:var(--t3); }
[data-theme="light"] #acBars .up { fill:var(--amber-dk); }

/* the empty state: until there are two places and a pay, only the answer card shows */
.ac-results.is-blank .ac-results-inner > :not(.ac-hero-card) { display:none; }
.ac-compare-side { flex:1 1 0; min-width:0; }
.ac-compare-side .ac-select { width:100%; }
.ac-swap {
  flex:0 0 auto; display:inline-flex; align-items:center; justify-content:center;
  width:44px; height:44px; margin-bottom:1px; padding:0;
  background:var(--raised); color:var(--t2);
  border:1px solid var(--border); border-radius:10px; cursor:pointer;
