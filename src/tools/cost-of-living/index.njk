/* ── form dock ── */
.ac-form-inner { padding:14px 16px 28px; display:flex; flex-direction:column; gap:18px; }
.ac-sec { display:flex; flex-direction:column; gap:8px; }
.ac-sec-label { font-family:var(--mono); font-size:var(--t-micro); font-weight:600; letter-spacing:.14em; text-transform:uppercase; color:var(--t3); display:flex; align-items:center; gap:6px; }
/* icons are wayfinding, not signal: faded ink keeps teal for data (One Signal Rule) */
