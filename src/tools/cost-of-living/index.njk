.ac-pc-seg.kept.asg { background:var(--teal-dk); }
[data-theme="light"] .ac-pc-seg.kept.cur { background:var(--blue); }
.ac-pc-seg:first-child { border-radius:4px 0 0 4px; }
.ac-pc-seg:last-child { border-radius:0 4px 4px 0; }
.ac-pc-seg:only-child { border-radius:4px; }
.ac-pc-seg .l { pointer-events:none; }
.ac-pc-seg .l.gone { visibility:hidden; }
.ac-pc-pay { position:absolute; top:-4px; bottom:-4px; width:0; border-left:2px solid var(--amber); }
