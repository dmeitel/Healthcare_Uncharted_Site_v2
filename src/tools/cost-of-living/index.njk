.ac-dash-sub { font-size:var(--t-ui); color:var(--t3); margin:4px 0 0; }
.ac-dash-table { width:100%; border-collapse:collapse; font-size:var(--t-body); }
.ac-dash-table th, .ac-dash-table td { padding:10px 0 10px 16px; text-align:right; border-bottom:1px solid var(--border); }
