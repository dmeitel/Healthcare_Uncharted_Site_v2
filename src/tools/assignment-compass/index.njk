  if (rent) tiles += tile(fmt(rent), (c.z ? 'market rent (Zillow ' + (CDATA._meta.zoriMonth || '').slice(0, 7) + ')' : 'median gross rent (ACS)'), 'asg');
  var home = c.h || c.v;
  if (home) tiles += tile(fmt(home), c.h ? 'home value (ZHVI)' : 'median home value (ACS)', '');
