          </div>
          <div class="ac-chiprow" role="group" aria-label="Which location these costs reflect">
            <button class="toggle-chip" id="acRefCur" aria-pressed="true">These are my current costs</button>
            <button class="toggle-chip" id="acRefAsg" aria-pressed="false">These are assignment costs</button>
          </div>
          <p class="ac-hint">Whichever side you enter anchors the math; the other side scales by the cost ratios below.</p>
        </div>

      </div>
    </aside>

    <section class="shell-canvas ac-results" aria-label="Results">
      <div class="ac-results-inner">

        <div class="ac-card hu-ticks">
          <h2 class="ac-card-head"><i data-lucide="scale"></i>Bottom line<span class="ac-badge" id="acScopeBadge">State-level estimate</span></h2>
