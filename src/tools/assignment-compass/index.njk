  block(520, STATES[s.as] + ' leaves / mo' + (s.gross2 != null ? ' at ' + fmt(s.gross2) : ''), fmt(asg.position), '#4ECDC4');
  block(700, 'monthly delta', fmtSign(delta), Math.abs(delta) < 5 ? '#5A7898' : delta > 0 ? '#2D9B6F' : '#DF5752');
  if (be != null) {
