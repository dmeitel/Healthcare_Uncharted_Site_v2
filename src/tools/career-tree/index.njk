            <div class="hw-cond" id="hw-cond-working" hidden>
              <span class="hw-q-lbl hw-cond-lbl">Your current role <i>optional; it anchors your line</i></span>
              <input id="hw-role-in" class="hw-search-in" type="text" placeholder="Search 164 real roles&hellip;" autocomplete="off" aria-label="Search roles">
              <div class="hw-suggest" id="hw-role-list" hidden></div>
            </div>
            <div class="hw-cond" id="hw-cond-school" hidden>
              <span class="hw-q-lbl hw-cond-lbl">The credential you're pursuing <i>optional</i></span>
              <input id="hw-cred-in" class="hw-search-in" type="text" placeholder="RN, RRT, MLS, coding&hellip;" autocomplete="off" aria-label="Search credentials">
              <div class="hw-suggest" id="hw-cred-list" hidden></div>
            </div>
          </div>
          <div class="hw-q">
            <span class="hw-q-lbl">Where does your work center?</span>
            <div class="hw-chips" data-q="pull">
              <button class="hw-chip" type="button" data-v="patients" aria-pressed="false">Direct patient care</button>
              <button class="hw-chip" type="button" data-v="data" aria-pressed="false">Data &amp; informatics</button>
              <button class="hw-chip" type="button" data-v="ops" aria-pressed="false">Operations &amp; administration</button>
              <button class="hw-chip" type="button" data-v="hands" aria-pressed="false">Diagnostics &amp; technology</button>
            </div>
          </div>
          <div class="hw-q">
            <span class="hw-q-lbl">Highest education completed</span>
            <div class="hw-chips" data-q="edu">
              <button class="hw-chip" type="button" data-v="HS" aria-pressed="false">HS / GED</button>
              <button class="hw-chip" type="button" data-v="Cert" aria-pressed="false">Certificate</button>
              <button class="hw-chip" type="button" data-v="AS" aria-pressed="false">Associate</button>
              <button class="hw-chip" type="button" data-v="BS" aria-pressed="false">Bachelor's</button>
              <button class="hw-chip" type="button" data-v="MS" aria-pressed="false">Master's</button>
              <button class="hw-chip" type="button" data-v="Doc" aria-pressed="false">Doctoral</button>
            </div>
          </div>
          <div class="hw-q">
            <span class="hw-q-lbl">Career horizon</span>
            <div class="hw-chips" data-q="reach">
              <button class="hw-chip" type="button" data-v="next" aria-pressed="false">The next step up</button>
              <button class="hw-chip" type="button" data-v="lead" aria-pressed="false">Leadership track</button>
              <button class="hw-chip" type="button" data-v="unsure" aria-pressed="false">Undecided. Show the whole map</button>
            </div>
          </div>
          <div class="hw-preview" id="hw-preview" hidden></div>
          <div class="hw-go-row">
            <button class="hw-go" id="hw-go" type="button" disabled>Start my sheet</button>
            <span class="hw-go-hint" id="hw-go-hint">Answer all four and this lights up.</span>
          </div>
        </div>
        <div class="hw-skip">
          <span class="hw-skip-lbl">Already on LinkedIn?</span>
          <button class="hw-skip-btn" type="button" data-hw="linkedin">Import your profile PDF</button>
          <span class="hw-skip-lbl" style="margin-left:8px">Or jump straight in:</span>
          <button class="hw-skip-btn" type="button" data-hw="career">Career Matrix</button>
          <button class="hw-skip-btn" type="button" data-hw="edu">Education Matrix</button>
          <button class="hw-skip-btn" type="button" data-hw="atlas">Areas of Expertise</button>
          <button class="hw-skip-btn" type="button" data-hw="search">Search</button>
        </div>
      </div>
      </div>
      <!-- slim re-entry strip: sits in the old welcome slot while the build is
           empty AFTER the modal was dismissed (session-only, no cookie) -->
      <div class="hw-strip" id="hct-welcome-strip" hidden>
        <span class="hw-strip-txt"><b>New sheet.</b> Four questions set up your map, or load a saved build from More in the toolbar.</span>
        <button class="hw-strip-btn" id="hw-reopen" type="button">Start here →</button>
      </div>
      <div id="bp-status" hidden></div>
      <!-- IDENTITY BAR -->
      <div class="bp-id">
        <div class="bp-id-block">
          <input class="bp-id-name" id="bp-name" placeholder="Your name" maxlength="40" autocomplete="off">
          <div class="bp-id-tagline" id="bp-tagline" style="display:none"></div>
          <div class="bp-id-sub" id="bp-role">Add your current role to begin</div>
        </div>
        <div class="bp-id-center">
          <div class="bp-id-vitals" id="bp-vitals"></div>
        </div>
        <div class="bp-id-block bp-id-goal">
          <label class="bp-id-lbl">Goal</label>
          <input class="bp-id-goal-in" id="bp-goal" placeholder="What you're aiming for (e.g., CRNA)" maxlength="60" autocomplete="off">
        </div>
      </div>

      <!-- CHARACTER CREATION — the four stations live ON the numbered section headers
           below: who you are + what you're becoming (①), the road (②), your
           specialization (③), the plan (④). Each header carries a guide chip; the
           first incomplete one gets the arrow and opens a focused picker. State, not tour. -->
      <div id="bp-station-modal" class="bp-modal" role="dialog" aria-modal="true" aria-labelledby="bp-station-h">
        <div class="bp-modal-card">
          <button class="bp-modal-x icon-btn" id="bp-station-x" type="button" title="Close" aria-label="Close"><i data-lucide="x" aria-hidden="true"></i></button>
          <div class="bp-modal-h" id="bp-station-h"></div>
          <div id="bp-station-body"></div>
        </div>
      </div>

      <!-- PHONE ONLY: the sheet folds to this deck of section cards plus a back
           bar (see the phone media block). Desktop never shows either. -->
      <div id="bp-pdeck"></div>
      <div id="bp-pback" hidden><button type="button" id="bp-pback-btn">&larr; My Path</button><span id="bp-pback-t"></span></div>

      <!-- THE SHEET reads as the story, top to bottom: ① your line ② the road
           ③ your specialization ④ the plan. Notes ride below as an appendix dash. -->
      <div class="bp-sheet">
        <div class="bp-col">
          <div class="bp-panel bp-panel-trunk bp-sec" data-sec="line">
            <div class="bp-h"><span class="bp-secn">1</span>Career Path<button class="bp-guide" id="bp-guide-line" type="button" hidden></button><button class="bp-h-link" type="button" data-goview="career">Browse roles →</button></div>
            <p class="bp-hint">Who you are and what you're becoming, on one line. Roles you've held, then the ones you're aiming at. Hit + and type a name to search real roles.</p>
            <div class="bp-grid" id="bp-grid-career"></div>
          </div>
          <div class="bp-panel bp-panel-trunk bp-sec" data-sec="road">
            <div class="bp-h"><span class="bp-secn">2</span>Education<button class="bp-guide" id="bp-guide-road" type="button" hidden></button><button class="bp-h-link" type="button" data-goview="edu">Browse credentials →</button></div>
            <p class="bp-hint">The road between here and the goal. Degrees, licenses, and certs, earned or in progress. Hit + to search credentials, or * for all.</p>
            <div class="bp-grid" id="bp-grid-education"></div>
          </div>
          <!-- expertise starter: suggestions keyed off your current role's family — offers, never auto-adds -->
          <div class="bp-suggest-strip" id="bp-suggest" hidden></div>
          <div class="bp-panel bp-sec" data-sec="spec">
            <div class="bp-h"><span class="bp-secn">3</span>Areas of Expertise<button class="bp-guide" id="bp-guide-spec" type="button" hidden></button><button class="bp-h-link" type="button" data-goview="atlas">See the map →</button></div>
            <p class="bp-hint">Your specialization: the skills, focus areas, settings, and populations you claim. Search each track, or tap a suggestion above.</p>
            <div class="bp-zones">
              <div class="bp-zone">
                <div class="bp-zone-h">Skills</div>
                <div class="bp-pick"><input id="bp-skill-search" class="bp-pick-in" placeholder="Search skills (airway, vitals, charting…)" autocomplete="off"><div class="bp-suggest" id="bp-skill-suggest"></div></div>
                <div class="bp-spiral-wrap" id="bp-grid-skill"></div>
              </div>
              <div class="bp-zone">
                <div class="bp-zone-h">Specializations</div>
                <div class="bp-pick"><input id="bp-spec-search" class="bp-pick-in" placeholder="Search focus areas (ICU, peds, trauma…)" autocomplete="off"><div class="bp-suggest" id="bp-spec-suggest"></div></div>
                <div class="bp-spiral-wrap" id="bp-grid-spec"></div>
              </div>
              <div class="bp-zone">
                <div class="bp-zone-h">Experience</div>
                <div class="bp-pick"><input id="bp-exp-search" class="bp-pick-in" placeholder="Search settings (ICU, ED, rural…)" autocomplete="off"><div class="bp-suggest" id="bp-exp-suggest"></div></div>
                <div class="bp-spiral-wrap" id="bp-grid-experience"></div>
              </div>
              <div class="bp-zone">
                <div class="bp-zone-h">Populations</div>
                <div class="bp-pick"><input id="bp-pop-search" class="bp-pick-in" placeholder="Search patient types & journeys (peds, ICU patient, prenatal…)" autocomplete="off"><div class="bp-suggest" id="bp-pop-suggest"></div></div>
                <div class="bp-spiral-wrap" id="bp-grid-population"></div>
              </div>
            </div>
          </div>
          <div class="bp-panel bp-panel-next bp-sec" data-sec="plan">
            <div class="bp-h"><span class="bp-secn">4</span>Next Steps<button class="bp-guide" id="bp-guide-plan" type="button" hidden></button></div>
            <p class="bp-hint">The plan, derived from the gap: what your future tiles demand, in exams and credentials. The small circles inside a step are its requirements. Tick what you already hold. Tap the step itself when you land the whole thing and it moves to your Current layer.</p>
            <div id="bp-next" class="bp-next"></div>
          </div>
          <div class="bp-dash-bar">
            <span class="bp-dash-lbl">Your notes · drag to rearrange</span>
            <div class="bp-addwrap"><button class="bp-addbtn" id="bp-add-section">+ Add section</button><div class="bp-addmenu" id="bp-add-menu"></div></div>
          </div>
          <div class="bp-dash" id="bp-dash"></div>
        </div>
      </div>
      <!-- Save / Load (export-import the whole build as a code/file) -->
      <div id="bp-data-modal" class="bp-modal" role="dialog" aria-modal="true" aria-label="Save or load your path">
        <div class="bp-modal-card">
          <button class="bp-modal-x icon-btn" id="bp-data-x" type="button" title="Close" aria-label="Close"><i data-lucide="x" aria-hidden="true"></i></button>
          <div class="bp-modal-h">Save / Load your path</div>
          <div class="bp-modal-sec">
            <div class="bp-modal-lbl">Start from LinkedIn. On your profile, click <b>More → Save to PDF</b>, then load that file here to auto-build your path. <b>This replaces your current path.</b> The file is read in your browser. Nothing is uploaded.</div>
            <div class="bp-modal-row"><label class="bp-modal-btn bp-modal-file primary">⬆ Import LinkedIn PDF…<input type="file" id="bp-li-file" accept="application/pdf,.pdf" hidden></label><span id="bp-li-msg" class="bp-modal-msg"></span></div>
          </div>
          <div class="bp-modal-sec">
            <div class="bp-modal-lbl">Back up. Copy this code, or download it as a file. Paste/load it on any device to restore everything.</div>
            <textarea id="bp-data-out" class="bp-modal-ta" readonly spellcheck="false"></textarea>
            <div class="bp-modal-row"><button id="bp-data-copy" class="bp-modal-btn">Copy code</button><button id="bp-data-dl" class="bp-modal-btn">Download file</button></div>
          </div>
          <div class="bp-modal-sec">
            <div class="bp-modal-lbl">Restore. Paste a code or load a file, then Import. <b>This replaces your current path.</b></div>
            <textarea id="bp-data-in" class="bp-modal-ta" placeholder="Paste your saved code here…" spellcheck="false"></textarea>
            <div class="bp-modal-row"><label class="bp-modal-btn bp-modal-file">Load file…<input type="file" id="bp-data-file" accept=".txt,.json,application/json,text/plain" hidden></label><button id="bp-data-import" class="bp-modal-btn primary">Import</button><span id="bp-data-msg" class="bp-modal-msg"></span></div>
          </div>
        </div>
      </div>
      <!-- the legend now lives in the "How it works" popover (sheet on phone) — the
           docked aside fought the sheet for width and never worked at phone size -->
    </section>

    <!-- Detail panel overlay (fades in, docked right) -->
    <aside id="hct-panel" class="hu-ticks" aria-label="Role detail">
      <!-- phone detent grabber (hidden on desktop): tap = half⇄full, drag = peek/half/full, drag past the bottom = dismiss -->
      <button class="hu-sheet-grab hct-p-grab" id="hct-p-grab" type="button" aria-label="Resize the detail sheet. Drag down past the bottom to close"><span></span></button>
      <div class="hct-p-head">
        <button class="hct-p-close icon-btn" id="hct-p-close" type="button" aria-label="Close detail panel"><i data-lucide="x" aria-hidden="true"></i></button>
        <span class="hct-p-badge" id="hct-p-badge"><span class="hct-p-dot"></span><span class="lbl"></span></span>
        <h2 class="hct-p-title" id="hct-p-title"></h2>
        <div class="hct-p-abbr" id="hct-p-abbr"></div>
        <button id="hct-p-focus" class="hct-p-focus" type="button">Focus line</button>
      </div>
      <!-- the card's second menu (map-drawer grammar): Details | Connections · fills from openPanel, decks only -->
      <div class="hct-p-tabs" id="hct-p-tabs"></div>
      <div class="hct-p-body" id="hct-p-body"></div>
    </aside>

  </div>
</div>

