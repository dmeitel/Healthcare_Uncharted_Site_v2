@media (max-width: 699px) {
  /* ── APP TABS (David's call, phone QA 2026-08-23): "maybe it needs to run more like
     the home page, the menus have swaps at the bottom and a dedicated screen for each
     thing." He is right: Path / Careers / Education / Skills are SCREENS, not
     controls, and screens belong in a bottom tab bar the way the home page already
     works. The pull-up sheet keeps only DETAILS; navigation never hides in it.
     Same chrome contract as .hu-bbar: 56px items, blur, safe-area, teal active. */
  #hct-tabs {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 150;
    display: grid; grid-template-columns: repeat(4, 1fr);
    background: color-mix(in srgb, var(--dark) 96%, transparent);
    backdrop-filter: blur(16px);
    border: none; border-top: 1px solid var(--border2); border-radius: 0;
    padding-bottom: env(safe-area-inset-bottom); overflow: visible;
  }
  #hct-tabs button {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 3px; min-height: 56px; position: relative;
    font-family: var(--mono); font-size: 10px; letter-spacing: .06em; text-transform: uppercase;
    background: none; border: none; border-radius: 0; color: var(--t3);
  }
  #hct-tabs button.on { background: none; color: var(--teal); font-weight: 700; }
  [data-theme="light"] #hct-tabs button.on { color: var(--teal-ink); }
  #hct-tabs button svg, #hct-tabs button i[data-lucide] { width: 19px; height: 19px; }
  /* the pin-count badge rides the icon's corner instead of the label line */
  #hct-tabs .tab-badge, #hct-tabs .tab-count { position: absolute; top: 5px; right: calc(50% - 22px); }
  /* the canvas clears the bar */
  #hct-shell { padding-bottom: calc(64px + env(safe-area-inset-bottom)); }
  /* the wordmark retires: the site nav one row up already says it (same call as the
     atlas and multi-lens) */
  #hct-tb .hct-logo, #hct-tb .hct-sep { display: none; }
  /* THE SOFT-LOCK FIX (David hit it live, 2026-08-23): the toolbar is z-40 and the
     panel was z-30, so a sheet dragged to full slid its header UNDER the toolbar —
     grabber, X and title all buried beneath fixed chrome, tab bar already yielded,
     and the careers view is exempt from the off-panel tap dismisser. Every visible
     exit gone at once. One surface at a time means the sheet COVERS the chrome, not
     ducks under it. */
  #hct-panel { z-index: 60; }
  /* The board verbs leave the phone (David: "do we need these icons up at all times?").
     Family / Pathways / Discipline filter the desktop canvas; fit and free-look frame
     it. The canvas is display:none on phone, so every one of them commanded a surface
     the reader cannot see. The flows are the phone answer and they need none of it.
     What stays: search, your saved build, help — one slim row — and Path's own
     controls, which act on the planner itself. */
  #tbc-career, #tbc-edu, #tbc-atlas { display: none !important; }
  /* the tab bar (z-150) was burying the z-25 attribution chip: lift it clear */
  .tool-attribution--fixed { bottom: calc(63px + env(safe-area-inset-bottom)); }
  /* ── MY PATH phone flow (David 2026-08-23: "too much stuff stacked... fill out
     each of those sections as their own pop ups or windows"). The sheet was a
     2100px wall inside a 234px scroll strip: swiping most of the screen moved
     NOTHING. The view is now ONE scroll surface. At rest, the four story
     sections + notes fold to a deck of summary cards (the same hpf grammar as
     the other three tabs); a tap gives one section the whole screen with a back
     bar, and hardware back walks it. Desktop keeps the full sheet. */
  #hct-mypath { overflow-y: auto; -webkit-overflow-scrolling: touch; }
  #hct-mypath > * { flex-shrink: 0; }   /* scroll, never squish (the maps' sheet lesson) */
  #hct-mypath .bp-sheet { flex: none; overflow: visible; }
  #bp-pdeck { display: block; padding: 4px 10px calc(14px + env(safe-area-inset-bottom)); }
  #hct-mypath:not([data-psec]) .bp-sheet { display: none; }
  #hct-mypath[data-psec] #bp-pdeck,
  #hct-mypath[data-psec] #bp-status,
  #hct-mypath[data-psec] .bp-id,
  #hct-mypath[data-psec] .hw-strip { display: none; }
  #hct-mypath[data-psec="line"] .bp-sec:not([data-sec="line"]),
  #hct-mypath[data-psec="road"] .bp-sec:not([data-sec="road"]),
  #hct-mypath[data-psec="spec"] .bp-sec:not([data-sec="spec"]),
  #hct-mypath[data-psec="plan"] .bp-sec:not([data-sec="plan"]),
  #hct-mypath[data-psec="notes"] .bp-sec { display: none; }
  #hct-mypath[data-psec]:not([data-psec="notes"]) .bp-dash-bar,
  #hct-mypath[data-psec]:not([data-psec="notes"]) #bp-dash { display: none; }
  #hct-mypath[data-psec]:not([data-psec="spec"]) .bp-suggest-strip { display: none; }
  #bp-pback:not([hidden]) { position: sticky; top: 0; z-index: 8; display: flex; align-items: center; gap: 8px;
    padding: 4px 10px; background: color-mix(in srgb, var(--dark) 96%, transparent);
    backdrop-filter: blur(10px); border-bottom: 1px solid var(--border2); }
  #bp-pback-btn { appearance: none; background: none; border: none; color: var(--teal);
    font-family: var(--mono); font-size: 12px; min-height: 44px; padding: 0 8px; cursor: pointer; }
  [data-theme="light"] #bp-pback-btn { color: var(--teal-ink); }
  [data-theme="light"] #bp-pback:not([hidden]) { background: color-mix(in srgb, #ffffff 94%, transparent); }
  #bp-pback-t { font-family: var(--display); font-weight: 700; font-size: 13px; color: var(--t1); }
  /* one surface at a time: the sheet owns the screen, the tab bar returns on dismiss */
  #hct-shell:has(#hct-panel.open) #hct-tabs { display: none; }
}
