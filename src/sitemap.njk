---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{#- lastmod is the page's real last-changed date (the lastChanged filter, its source's last commit); changefreq is gone
    because Google ignores it (both from the Search Console card, 2026-10-11). -#}
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}
{%- if p.url and p.url != '/404.html' and p.data.status != 'draft' and not p.data.noindex %}
  <url>
    <loc>{{ site.url }}{{ p.url }}</loc>
    {%- set changed = p.inputPath | lastChanged(p.date) %}
    {%- if changed %}<lastmod>{{ changed | dateISO }}</lastmod>{% endif %}
  </url>
{%- endif %}
{%- endfor %}
</urlset>
