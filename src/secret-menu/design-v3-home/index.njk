        <div class="vh-bbar"><span class="on">◆ Home</span><span>Tools</span><span style="color:#062024;background:#4ECDC4;border-radius:999px;margin:4px 3px;padding:6px 0;font-weight:700">Search</span><span>Learn</span><span>More</span></div>
