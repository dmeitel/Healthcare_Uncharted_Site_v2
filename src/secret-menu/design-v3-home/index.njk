      .vh-res { display:flex; align-items:baseline; gap:7px; padding:6px 13px; font-size:9px; color:#b8cfe8; }
      .vh-res b { color:#fff; font-weight:600; }
      .vh-res.hot { background:#162030; border-left:2px solid #4ECDC4; }
