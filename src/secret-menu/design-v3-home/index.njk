  <!-- ══ 1B · THE SEARCH, VISUALLY ══ -->
  <section class="vb-plate">
    <div class="vb-plate-h"><span class="vb-plate-num">1B</span><h2>The search, visually</h2><span class="thesis">a switchboard with four states, never a dead end</span></div>
    <style>
