      <div class="vb-cell" style="flex-basis:330px">
        <span class="vb-tag">State 2 · Typing: their word, our destination</span>
        <div class="vh-pal">
          <div class="vh-pal-in"><span style="color:#5A7898">⌕</span>trav<span class="cur"></span></div>
