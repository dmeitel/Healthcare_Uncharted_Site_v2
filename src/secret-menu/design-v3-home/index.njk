    <div class="vb-row">

      <div class="vb-cell" style="flex-basis:330px">
        <span class="vb-tag">State 1 · Opened empty: it browses</span>
        <div class="vh-pal">
          <div class="vh-pal-in"><span style="color:#5A7898">⌕</span><span class="cur"></span><span class="ph">Where do you want to go?</span></div>
          <div class="vh-sec">Jump in</div>
          <div style="padding:2px 13px 6px" class="vh-chiprow"><span class="vh-chip">Careers &amp; Pay</span><span class="vh-chip">Maps &amp; Systems</span><span class="vh-chip">Learn &amp; Play</span></div>
          <div class="vh-sec">Three ways in</div>
          <div class="vh-res"><b>I work in healthcare</b><span class="ty">Path</span></div>
          <div class="vh-res"><b>I work with the data</b><span class="ty">Path</span></div>
          <div class="vh-sec">New on the site</div>
