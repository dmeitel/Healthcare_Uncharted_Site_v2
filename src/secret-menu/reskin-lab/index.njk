/* ══ QUIET PRECISION BASE: applies to EVERY column on this board ══
   zero glow · state = ink + weight · boxes become rules · body 400 ·
   solid teal active chips · margin-note callouts · ruled mastless bars */
.sp { background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:18px; }
.sp-kicker { font-family:var(--mono); font-size:9px; letter-spacing:.18em; text-transform:uppercase; color:var(--t3); }
.sp-name { font-family:var(--display); font-size:20px; font-weight:800; color:var(--t1); line-height:1.15; margin:2px 0; letter-spacing:-.03em; }
.sp-sub { font-family:var(--mono); font-size:11px; color:var(--t3); margin-bottom:14px; }
.sp-stats { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:12px; }
.sp-stat { border-top:2px solid var(--border2); padding:8px 2px 0; min-width:0; }
.sp-stat .v { font-family:var(--display); font-size:25px; font-weight:800; color:var(--t1); line-height:1.1; letter-spacing:-.02em; }
.sp-stat .v.hi { color:var(--teal); }
[data-theme="light"] .sp-stat .v.hi { color:var(--teal-dk); }
.sp-stat .k { font-family:var(--mono); font-size:8.5px; letter-spacing:.18em; text-transform:uppercase; color:var(--t3); margin-top:5px; }
.sp-fact { display:flex; align-items:baseline; gap:6px; padding:7px 0; border-bottom:1px solid var(--border); font-size:12.5px; }
.sp-fact span { color:var(--t2); font-weight:400; flex:none; }
.sp-fact b { font-family:var(--mono); font-weight:600; color:var(--t1); margin-left:auto; text-align:right; }
.sp-src { font-family:var(--mono); font-size:9.5px; color:var(--t3); margin-top:14px; padding-top:10px; border-top:1px solid var(--border); line-height:1.5; }
.sp-chips { display:flex; flex-wrap:wrap; gap:5px; margin-top:10px; }
.sp-chips i { font-style:normal; font-family:var(--mono); font-size:10px; color:var(--t2); border:1px solid var(--border); border-radius:999px; padding:3px 8px; }
.sp-tabs { display:flex; gap:2px; border-bottom:1px solid var(--border); margin-bottom:10px; }
.sp-tab { font-family:var(--font); font-size:12px; font-weight:600; color:var(--t3); padding:7px 14px; border:none; background:none; }
.sp-tab.on { color:var(--teal); border-bottom:2px solid var(--teal); }
[data-theme="light"] .sp-tab.on { color:var(--teal-dk); border-color:var(--teal-dk); }
.sp-lens { font-family:var(--mono); font-size:9.5px; letter-spacing:.12em; text-transform:uppercase; color:var(--t3); margin:10px 0 4px; }
.sp-row { display:flex; align-items:center; gap:8px; padding:10px 2px; border-bottom:1px solid var(--border); }
.sp-row .nm { font-size:12.5px; color:var(--t1); flex:1; min-width:0; }
.sp-row.on { border-bottom-color:var(--teal); }
.sp-row.on .nm { font-weight:700; color:var(--teal); }
[data-theme="light"] .sp-row.on .nm { color:var(--teal-dk); }
.sp-row .mini { font-family:var(--mono); font-size:9.5px; color:var(--t2); border:1px solid var(--border2); border-radius:999px; padding:3px 8px; white-space:nowrap; }
.sp-chiprail { display:flex; gap:6px; flex-wrap:wrap; }
.sp-chip { font-family:var(--font); font-size:12px; font-weight:600; color:var(--t2); background:var(--raised); border:1px solid var(--border); border-radius:999px; padding:7px 13px; }
.sp-chip.on { background:var(--teal); border-color:var(--teal); color:#062024; font-weight:700; }
.sp-toolbar { display:flex; align-items:center; gap:10px; border-bottom:2px solid var(--border2); padding:10px 2px; }
.sp-toolbar .tk { font-family:var(--mono); font-size:9px; letter-spacing:.14em; text-transform:uppercase; color:var(--t3); }
.sp-toolbar .tt { font-family:var(--display); font-size:15px; font-weight:800; color:var(--t1); }
.sp-toolbar .tt span { color:var(--teal); }
[data-theme="light"] .sp-toolbar .tt span { color:var(--teal-dk); }
.sp-fabs { display:flex; gap:10px; align-items:center; justify-content:center; padding:10px 0 2px; }
.sp-fab { width:44px; height:44px; border-radius:50%; background:var(--surface); border:1px solid var(--border2); color:var(--t1); display:flex; align-items:center; justify-content:center; box-shadow:0 4px 16px rgba(0,0,0,.4); font-size:16px; }
.sp-listpill { font-family:var(--font); font-size:12px; font-weight:700; color:var(--t2); background:var(--surface); border:1px solid var(--border2); border-radius:999px; padding:11px 20px; box-shadow:0 4px 16px rgba(0,0,0,.4); }
.sp-btnrow { display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
.sp-btn-p { background:var(--blue); color:#fff; border:none; border-radius:10px; padding:11px 20px; font-family:var(--font); font-size:13px; font-weight:700; }
.sp-btn-g { background:transparent; color:var(--t2); border:1px solid var(--border2); border-radius:10px; padding:11px 20px; font-family:var(--font); font-size:13px; font-weight:500; }
.sp-input { background:var(--raised); border:1px solid var(--border); border-radius:8px; padding:9px 12px; color:var(--t1); font-family:var(--font); font-size:13px; width:100%; }
.sp-callout { border-left:3px solid var(--amber); padding:6px 0 6px 14px; margin-top:12px; }
[data-theme="light"] .sp-callout { border-left-color:var(--amber-dk); }
.sp-callout h4 { font-size:12px; font-weight:700; color:var(--t1); margin-bottom:3px; }
.sp-callout p { font-size:11px; color:var(--t2); line-height:1.5; }
.sp-hexrow { display:flex; gap:12px; align-items:center; justify-content:center; padding:8px 0; }
.sp-hex { width:92px; height:80px; clip-path:polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%); background:#0b1f16; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3px; position:relative; }
.sp-hex::before { content:''; position:absolute; inset:2px; clip-path:polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%); background:#0e2a1e; }
.sp-hex b { position:relative; font-family:var(--display); font-size:11px; font-weight:800; color:#d9f2e6; text-align:center; line-height:1.2; }
.sp-hex i { position:relative; font-style:normal; font-family:var(--mono); font-size:8px; color:#4ecb8d; letter-spacing:.08em; }
.sp-zonepills { display:flex; gap:5px; justify-content:center; flex-wrap:wrap; }
.sp-zp { font-family:var(--mono); font-size:9px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; padding:3px 10px; border-radius:20px; }
.sp-zp.pt { background:rgba(78,205,196,.12); color:#4ECDC4; border:1px solid rgba(78,205,196,.34); }
.sp-zp.py { background:rgba(232,168,56,.12); color:#E8A838; border:1px solid rgba(232,168,56,.34); }
.sp-zp.po { background:rgba(139,92,246,.16); color:#b59ff5; border:1px solid rgba(139,92,246,.36); }

/* ══ QP1 · RULED LEDGER ══
   The annual-report table: leader dots carry the eye from label to
   value, stats sit on ONE baseline row split by hairlines, units set
   smaller than their figures, everything right-ranged and tabular. */
.rl-q1 .sp-fact .ld { flex:1; border-bottom:1px dotted var(--t4); transform:translateY(-3px); margin:0 4px; min-width:16px; }
.rl-q1 .sp-fact b { margin-left:0; }
.rl-q1 .sp-stats { display:flex; gap:0; border-top:2px solid var(--border2); border-bottom:1px solid var(--border); }
.rl-q1 .sp-stat { border-top:none; flex:1; padding:10px 12px; }
.rl-q1 .sp-stat + .sp-stat { border-left:1px solid var(--border); }
.rl-q1 .sp-stat .v { font-variant-numeric:tabular-nums; }
.rl-q1 .sp-stat .v small, .rl-q1 .sp-fact b small { font-size:.6em; font-weight:600; color:var(--t3); margin-left:1px; }
.rl-q1 .sp-row .nm { font-variant-numeric:tabular-nums; }
.rl-q1 .sp-src { text-align:right; }
.rl-q1 .sp-toolbar .tt { font-variant-numeric:tabular-nums; }

/* ══ QP2 · MASTHEAD ══
   Type is the structure: the kicker rotates into a left margin rail,
   the name runs the full measure over a heavy rule, ghost buttons
   dissolve into underlined text, sections carry index numerals. */
.rl-q2 .sp { display:grid; grid-template-columns:26px 1fr; gap:0 12px; }
.rl-q2 .sp > * { grid-column:2; }
.rl-q2 .sp-kicker { grid-column:1; grid-row:1 / span 8; writing-mode:vertical-rl; transform:rotate(180deg); align-self:start; border-left:2px solid var(--teal); padding-left:6px; letter-spacing:.22em; height:max-content; }
[data-theme="light"] .rl-q2 .sp-kicker { border-left-color:var(--teal-dk); }
.rl-q2 .sp-name { font-size:23px; border-bottom:3px solid var(--border2); padding-bottom:8px; margin-bottom:6px; }
.rl-q2 .sp-toolbar { border-bottom:3px solid var(--border2); }
.rl-q2 .sp-toolbar .tt { font-size:17px; }
.rl-q2 .sp-btn-g { border:none; border-radius:0; padding:11px 2px; color:var(--t2); text-decoration:underline; text-underline-offset:5px; text-decoration-color:var(--border2); font-weight:600; }
.rl-q2 .sp-lens { display:flex; align-items:baseline; gap:8px; }
.rl-q2 .sp-lens::before { content:'01'; font-size:8.5px; color:var(--border2); letter-spacing:.05em; }
.rl-q2 .sp-callout h4::before { content:'N.B. '; font-family:var(--mono); font-size:9px; color:var(--amber); letter-spacing:.1em; }
[data-theme="light"] .rl-q2 .sp-callout h4::before { color:var(--amber-dk); }

/* ══ QP3 · CARTOGRAPHIC QUIET ══
   The atlas whispered: hairline corner ticks in BORDER gray (never
   accent), names uppercase and letterspaced, fact labels become mono
   captions, tiny geometric markers lead list rows. */
.rl-q3 .sp { position:relative; border-radius:10px; }
.rl-q3 .sp::before, .rl-q3 .sp::after { content:''; position:absolute; width:10px; height:10px; pointer-events:none; }
.rl-q3 .sp::before { top:5px; left:5px; border-top:1px solid var(--border2); border-left:1px solid var(--border2); }
.rl-q3 .sp::after { bottom:5px; right:5px; border-bottom:1px solid var(--border2); border-right:1px solid var(--border2); }
.rl-q3 .sp-name { font-size:14px; text-transform:uppercase; letter-spacing:.09em; }
.rl-q3 .sp-fact span { font-family:var(--mono); font-size:9px; letter-spacing:.12em; text-transform:uppercase; color:var(--t3); }
.rl-q3 .sp-row .nm::before { content:'▸ '; color:var(--t4); font-size:10px; }
.rl-q3 .sp-row.on .nm::before { content:'◆ '; color:var(--teal); }
[data-theme="light"] .rl-q3 .sp-row.on .nm::before { color:var(--teal-dk); }
.rl-q3 .sp-stat .k { color:var(--t3); }
.rl-q3 .sp-stat .k::before { content:'· '; color:var(--border2); }
.rl-q3 .sp-chips i { border-radius:4px; }
.rl-q3 .sp-sub::before { content:'⌖ '; color:var(--t4); }
.rl-q3 .sp-toolbar .tk::before { content:'─ '; color:var(--border2); letter-spacing:0; }
.rl-q3 .sp-hex b { text-transform:uppercase; font-size:9.5px; letter-spacing:.06em; }

@media (max-width:1100px) { .rl-grid { grid-template-columns:repeat(2,1fr); } }
@media (max-width:699px) { .rl-grid { grid-template-columns:1fr; } }
</style>

