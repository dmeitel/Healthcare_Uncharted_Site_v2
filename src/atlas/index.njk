}
/* catalog markers: rows here are picked (hover-preview + click-select a route) */
.conn-row::before { content: '\25B8'; font-family: var(--mono); font-size: 10px; color: var(--t4); flex-shrink: 0; }
.conn-row:hover { background: rgba(78,205,196,0.09); }
