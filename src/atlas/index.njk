/* ── Unified entity search (the whole dataset, attached to the atlas) ─── */
#atlas-find { position: absolute; top: 64px; right: 16px; width: min(400px, calc(100% - 32px)); z-index: 30; font-family: var(--font); }
/* The phone override MUST sit after the base rule: same specificity, and a media query
   adds none, so the later declaration wins. Run-2 raised the value (110 then 170) inside
   the early phone block and it never applied — computed top stayed 64 and the search bar
   sat on top of the wrapped controls row, which bottoms at ~164 (run-3 root cause). */
/* 170px cleared the control chips that used to stack top-right; they moved to
   the bottom dock 2026-08-23 and the bar was left floating mid-canvas (David's
   device pass). Docked under the breadcrumb, full width: the Watch Duty read. */
@media (max-width: 699px){ #atlas-find { top: 58px; left: 10px; right: 10px; width: auto; } }
#find-bar { display: flex; align-items: center; gap: 9px; background: rgba(8,14,20,0.92); border: 1px solid rgba(78,205,196,0.30); border-radius: 11px; padding: 9px 13px; backdrop-filter: blur(8px); box-shadow: 0 10px 34px rgba(0,0,0,0.45); }
#find-bar svg { flex: none; opacity: .6; width: 16px; height: 16px; stroke-width: 2; color: #4ECDC4; }
#find-input { flex: 1; background: none; border: none; outline: none; color: #dcefe9; font-size: 14px; font-family: inherit; }
#find-input::placeholder { color: rgba(140,180,200,0.45); }
#find-count { font-family: var(--mono); font-size: 10px; color: rgba(140,180,200,0.55); white-space: nowrap; font-variant-numeric: tabular-nums; }
#find-results { margin-top: 7px; max-height: min(58vh, 540px); overflow-y: auto; background: rgba(8,14,20,0.97); border: 1px solid rgba(78,205,196,0.18); border-radius: 11px; display: none; }
#find-results.open { display: block; }
#find-results::-webkit-scrollbar { width: 4px; } #find-results::-webkit-scrollbar-thumb { background: rgba(78,205,196,0.18); }
.find-grp { padding: 3px 0; }
.find-grp-h { display: flex; align-items: center; gap: 7px; padding: 8px 13px 4px; font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(140,180,200,0.6); }
.find-grp-h .gn { opacity: .55; }
.find-row { display: flex; align-items: center; gap: 9px; padding: 6px 13px; cursor: pointer; transition: background .1s; text-decoration: none; }
.find-row:hover { background: rgba(78,205,196,0.10); }
.find-dot { width: 7px; height: 7px; border-radius: 50%; flex: none; }
.find-lbl { flex: 1; min-width: 0; font-size: 13px; color: rgba(210,228,235,0.94); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.find-lbl mark { background: rgba(78,205,196,0.22); color: #7fead9; border-radius: 3px; padding: 0 1px; }
.find-sub { font-family: var(--mono); font-size: 9px; color: rgba(140,180,200,0.5); white-space: nowrap; }
.find-on { font-family: var(--mono); font-size: 8.5px; color: rgba(78,205,196,0.8); border: 1px solid rgba(78,205,196,0.32); border-radius: 4px; padding: 1px 5px; flex: none; }
.find-more { padding: 5px 13px 9px; font-family: var(--mono); font-size: 10px; color: rgba(140,180,200,0.45); }
.az-node-cell.az-find-hit .hex-body { stroke-opacity: 1 !important; stroke-width: 3px !important; fill-opacity: 0.34 !important; filter: url(#n-glow); }
[data-theme='light'] #find-bar { background: rgba(249,252,250,0.96); border-color: rgba(27,95,168,0.26); }
[data-theme='light'] #find-bar svg { stroke: var(--teal-dk); }
