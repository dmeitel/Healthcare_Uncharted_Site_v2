/* search-result detail summary (the entity card, on the atlas) ·
   instrument inspector: tabular numerals + hairline section dividers */
#find-detail { margin-top: 7px; max-height: min(62vh, 580px); overflow-y: auto; background: rgba(8,14,20,0.97); border: 1px solid rgba(78,205,196,0.18); border-radius: 11px; display: none; padding: 14px 15px; font-variant-numeric: tabular-nums; }
#find-detail.open { display: block; }
#find-detail::-webkit-scrollbar { width: 4px; } #find-detail::-webkit-scrollbar-thumb { background: rgba(78,205,196,0.18); }
.fd-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 9px; }
