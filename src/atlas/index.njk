}
.ctt-desc {
  font-family: var(--font); font-size: 12px;
  color: rgba(140,180,215,0.78); line-height: 1.58;
}

/* ── CONNECTIONS PANEL (searchable route list) ────────────────────────────── */
#atlas-conn {
  position: absolute; top: 0; left: 0; bottom: 0; z-index: 40;
  width: 314px; background: rgba(2,6,4,0.99);
  border-right: 2px solid rgba(78,205,196,0.22);
  box-shadow: 6px 0 32px rgba(0,0,0,0.6);
  transform: translateX(-100%); transition: transform .28s cubic-bezier(.4,0,.2,1);
  display: flex; flex-direction: column; overflow: hidden;
}
#atlas-conn.open { transform: translateX(0); }
#conn-hdr {
  padding: 16px 18px 12px; flex-shrink: 0;
  border-bottom: 1px solid rgba(78,205,196,0.12);
  display: flex; align-items: center; justify-content: space-between;
}
#conn-hdr-title {
  font-family: var(--display); font-size: 14px; font-weight: 800;
  letter-spacing: 0.09em; text-transform: uppercase; color: rgba(78,205,196,0.92);
}
#conn-panel-close {
  width: 26px; height: 26px; background: rgba(78,205,196,0.06);
  border: 1px solid rgba(78,205,196,0.18); color: rgba(78,205,196,0.55);
  cursor: pointer; font-size: 15px; display: flex; align-items: center;
  justify-content: center; transition: background-color .12s, border-color .12s, color .12s;
}
#conn-panel-close:hover { background: rgba(78,205,196,0.14); color: #4ECDC4; }
#conn-search {
  margin: 12px 14px 9px; padding: 8px 11px; flex-shrink: 0;
  background: rgba(78,205,196,0.06); border: 1px solid rgba(78,205,196,0.18);
  color: #cfe6e2; font-family: var(--font); font-size: 12.5px; outline: none;
}
#conn-search::placeholder { color: rgba(140,180,200,0.4); }
#conn-search:focus { border-color: rgba(78,205,196,0.42); }
#conn-filters {
  display: flex; flex-wrap: wrap; gap: 5px; padding: 0 14px 11px; flex-shrink: 0;
  border-bottom: 1px solid rgba(78,205,196,0.10);
}
.cf-chip {
  font-family: var(--mono); font-size: 8.5px;
  letter-spacing: 0.07em; text-transform: uppercase;
  padding: 4px 8px; cursor: pointer;
  background: rgba(78,205,196,0.05); border: 1px solid rgba(78,205,196,0.16);
  color: rgba(140,180,200,0.62); transition: background-color .12s, border-color .12s, color .12s;
}
.cf-chip.on { background: var(--teal); color: #062024; border-color: var(--teal); font-weight: 700; }
#conn-list { flex: 1; overflow-y: auto; padding: 6px 0; }
