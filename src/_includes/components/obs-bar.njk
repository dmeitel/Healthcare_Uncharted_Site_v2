{#- The one top bar for the Data Observatory's Process, Site and Traffic tabs. The Data map tab
    keeps its own bar (it is the h1 there) and includes obs-tabs.njk inside it. -#}
<link rel="stylesheet" href="/assets/css/observatory.css?v=20261004">
<header class="tool-bar">
  <a class="tb-brand" href="/" aria-label="Healthcare Uncharted, home">
    <img src="/brand/hu-mark-dark.svg" alt="" class="hu-logo-ondark">
    <img src="/brand/hu-mark.svg" alt="" class="hu-logo-onlight">
  </a>
  <span class="tool-bar-kicker">Secret Menu</span>
  <a class="tool-bar-title obs-home" href="/secret-menu/data-observatory/">Data <span>Observatory</span></a>
  {% include "components/obs-tabs.njk" %}
  <span class="tool-bar-spacer"></span>
  <a class="toggle-chip" href="/secret-menu/"><span>&larr;<span class="tool-bar-long"> Secret Menu</span></span></a>
  <button class="icon-btn" data-nav-summon type="button" aria-expanded="false" aria-label="Site menu" title="Site menu"><i data-lucide="menu" aria-hidden="true"></i></button>
</header>
