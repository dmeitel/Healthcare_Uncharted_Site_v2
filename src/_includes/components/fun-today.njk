{#- A DAILY'S CARD (2026-10-18), the Fun shelf's own card: the game's name, today's number, where you stand, and a brass
    button that opens today's puzzle itself. Full on /fun/today/ (with the game's picture), compact on the Fun page's
    "Today's puzzles" shelf (no picture, so both dailies sit near the top of a phone). The words in it are filled by
    src/assets/js/fun-today.js; what is here is what shows before that runs. One entry each in src/_data/dailies.js. -#}
{% macro dailyCard(d, compact) %}
  <a class="fn-game{% if compact %} fn-compact{% endif %}" href="{{ d.href }}" data-daily="{{ d.id }}" data-one="{{ d.one }}" data-word="{{ d.word }}">
    {%- if not compact %}
    <div class="fn-screen" aria-hidden="true"><div class="fn-thumb" style="--thumb:url('/assets/images/tool-thumbs/{{ d.thumb }}.png');--thumb-l:url('/assets/images/tool-thumbs/{{ d.thumb }}-light.png')"></div></div>
    {%- endif %}
    <div class="fn-body">
      <div class="fn-row"><span class="fn-name">{{ d.name }}</span><span class="fn-n" data-num>Today’s {{ d.word | lower }}</span></div>
      <p class="fn-desc fn-state" data-state>{{ d.line }}</p>
      <span class="hu-brass fn-play" aria-hidden="true" data-go>Play</span>
    </div>
  </a>
{% endmacro %}
