{#- THE FACILITY MAP SHELL (2026-10-03): the styles and markup of the Hospital Operations Map, shared since the
    Healthcare Schools Map became the second page on the same engine (src/assets/js/tools/operators-map.js reads
    data-map off .gv-shell). A page sets `fm` (see src/tools/operators-map/index.html) and includes this. -#}
{% raw %}
<!-- ════════════════════════════════════════════════════════════════
     U.S. HOSPITAL OPERATIONS MAP, v2, on the HU full-map standard
     (docs/HU-UI-GRAMMAR.md §5b). Promoted from the geo-v2 pilot
     2026-07-19; the D3 v1 lives in archive/operators-map-2026-07-19-d3-v1.html.
     Stack: MapLibre GL 5 + OpenFreeMap (fiord/positron by theme) +
     boundaries and pharmacy shards from scripts/build-geo-serving.js.
     Seven CMS datasets as toggleable layers; states→counties→facility
     drill; one click router (pin > cluster > county > state); draw
     search; locate-me via HUKit; old v1 URL params still honored.
════════════════════════════════════════════════════════════════ -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/maplibre-gl@5.6.0/dist/maplibre-gl.css" integrity="sha256-eSrJl9z2rm9kPrTi3uRjDIXnBWUmvY+4X/6Dxn1sQbQ=" crossorigin="anonymous">
<style>
.vh { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }
.gv-shell { position:relative; height:calc(100dvh - var(--nav-h)); overflow:hidden; }
#gvMap { position:absolute; inset:0; }

/* ── top stack: search pill + chip rail (the two persistent surfaces) ── */
.gv-top { position:absolute; top:10px; left:10px; right:10px; z-index:20; display:flex; flex-direction:column; gap:8px; pointer-events:none; }
.gv-top > * { pointer-events:auto; }
.gv-srow { display:flex; gap:8px; align-items:center; }
/* THE BRASS LOOK (2026-10-11, the site-wide refresh), the twin of the Population Health Map's pass: the ident and the
   legend are faces, the pills you press are keys, the search pill and the loading line are glass, the drawer and the
   search panel are faces with a brass hairline. The map, its colors, markers and legend swatches are untouched. */
.gv-ident { flex:none; display:flex; align-items:center; height:38px; padding:0 13px; border-radius:10px;
  background:var(--face-bg); border:1px solid var(--border); box-shadow:0 6px 14px var(--depth);
  font-family:var(--display); font-size:var(--t-fine); font-weight:700; color:var(--t2); white-space:nowrap; }
.gv-ident b { color:var(--teal); margin-left:4px; }
[data-theme="light"] .gv-ident b { color:var(--teal-ink); }
@media (max-width:699px), (max-height:500px){ .gv-ident { display:none; } }   /* phone: canvas gets the pixels, the tab carries the name */
/* scope-back: pops one level per tap. County → state → United States */
.gv-scope { flex:none; height:38px; padding:0 13px; border-radius:999px; cursor:pointer;
  background:var(--key-bg); border:1px solid transparent; border-top-color:var(--brass-rim);
  color:var(--key-ink); font-family:var(--font); font-size:var(--t-fine); font-weight:700;
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:42vw;
  box-shadow:var(--key-lift); }
/* the back chip's place name: in full on a desktop, short on a phone, so the search box keeps its words (2026-10-03) */
.gv-scope .sc-s { display:none; }
@media (max-width:699px), (max-height:500px){ .gv-scope .sc-l { display:none; } .gv-scope .sc-s { display:inline; } }
/* ...and with a place open, the search box drops its count on a phone (the List button and the card carry it) */
@media (max-width:699px), (max-height:500px){ .gv-srow:has(#gvScope:not([hidden])) .gv-pill .qn { display:none; } }
/* the search pill is a field, like the site search launcher (.hv-search): glass at night, a light well in day */
.gv-pill { flex:1; max-width:440px; display:flex; align-items:center; gap:9px; height:38px; padding:0 14px; border-radius:999px;
  background:var(--field-bg); border:1px solid transparent;
  color:var(--field-sub); font-family:var(--font); font-size:var(--t-ui); cursor:pointer;
  box-shadow:var(--field-well), 0 6px 14px var(--depth); text-align:left; overflow:hidden; }
.gv-pill:hover { box-shadow:var(--field-well), 0 0 0 1px var(--brass-lo), 0 6px 14px var(--depth); }
.gv-pill .q { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.gv-pill .q.set { color:var(--glass-ink); font-weight:600; }
/* the clear X is the pill's SIBLING (a button can't hold a button), so it is reached with +; written as a descendant it
   never hid, and the X sat on the placeholder with nothing to clear (2026-10-02) */
.gv-pillwrap .clr { margin-left:auto; flex:none; color:var(--glass-sub); font-size:var(--t-body); padding:4px; display:none; }
.gv-pill.has-q + .clr { display:block; }
.gv-pill.has-q { padding-right:32px; }   /* a long name stops short of the X */
.gv-pillwrap .clr:hover { color:var(--glass-ink); }
/* ── the chrome grammar: ONE bar, ONE drawer, ONE cluster ──
   The chip rail is gone. Filters live in the drawer's Display tab; the bar
   carries READOUT pills that say their state (Zillow move, variant A). */
.gv-rpill { flex:none; display:inline-flex; align-items:center; gap:6px; height:38px; padding:0 13px; border-radius:999px;
  background:var(--key-bg); border:1px solid transparent; border-top-color:var(--brass-rim);
  color:var(--key-sub); font-family:var(--font); font-size:var(--t-fine); font-weight:600; cursor:pointer;
  box-shadow:var(--key-lift); white-space:nowrap; }
.gv-rpill b { color:var(--key-ink); font-weight:700; }
.gv-rpill .car { color:var(--key-sub); font-size:var(--t-micro); }
/* THE KEYS' STATES (the recipe in docs/HU-BRASS-LOOK-2026-10-11.md): a brass top edge and a little light on hover, a
   press that sinks onto the floor, the site's teal focus ring */
@media (prefers-reduced-motion: no-preference){
  .gv-scope, .gv-rpill, .gv-listbtn, .gv-inset, .gv-tolist, .gv-tabs button, .gv-pill { transition:transform .12s ease, box-shadow .12s ease, filter .12s ease, border-color .15s; }
}
:is(.gv-scope, .gv-rpill, .gv-tolist):hover { color:var(--key-ink); border-color:transparent; border-top-color:var(--brass); filter:brightness(1.08); }
[data-theme="light"] :is(.gv-scope, .gv-rpill, .gv-tolist):hover { border-top-color:var(--brass-lo); filter:brightness(.97); }
:is(.gv-scope, .gv-rpill):active { transform:translateY(3px); box-shadow:var(--key-down); }
:is(.gv-scope, .gv-rpill, .gv-listbtn, .gv-inset, .gv-tolist):focus-visible { outline:2px solid var(--teal); outline-offset:2px; }
[data-theme="light"] :is(.gv-scope, .gv-rpill, .gv-listbtn, .gv-inset, .gv-tolist):focus-visible { outline-color:var(--teal-dk); }
/* view pills park RIGHT, stacked over the drawer they open (nav left, view right) */
#gvLayersPill { margin-left:auto; }
.gv-dispill { margin-left:auto; }
.gv-dispill { display:none; }
@media (max-width:849px){
  .gv-rpill { display:none; }
  .gv-rpill.gv-dispill { display:inline-flex; }   /* narrow: the two readouts fold into one ⚙ Display pill */
}
/* drawer tabs: Details (what you tapped) | Display (how the map reads) */
/* the Details|Display switch is the site's view switch (.hu-seg in hu-global.css): keys in a recessed track, the tab
   on screen in brass */
.gv-tabs { display:flex; gap:4px; background:var(--track-bg); box-shadow:var(--track-well);
  border-radius:9px; padding:3px; margin:4px 0 10px; flex:none; }
[data-theme="light"] .gv-tabs { background:var(--raised); box-shadow:inset 0 2px 6px var(--depth); }
.gv-tabs button { flex:1; border:1px solid transparent; border-top-color:var(--brass-rim); background:var(--key-bg); border-radius:7px; padding:6px 0;
  box-shadow:0 2px 0 var(--key-floor); font-family:var(--font); font-size:var(--t-label); font-weight:700; color:var(--key-ink); cursor:pointer; }
.gv-tabs button:hover { filter:brightness(1.08); }
[data-theme="light"] .gv-tabs button:hover { filter:brightness(.97); }
.gv-tabs button:active { transform:translateY(2px); box-shadow:none; }
.gv-tabs button.on { background:var(--brass-bg); border-color:transparent; color:var(--brass-ink); box-shadow:inset 0 1px 0 rgba(255,255,255,.5), 0 2px 0 var(--brass-deep); }
.gv-tabs button:focus-visible { outline:2px solid var(--teal); outline-offset:2px; }
[data-theme="light"] .gv-tabs button:focus-visible { outline-color:var(--teal-dk); }
/* ── Fixed header, scrolling body (David's phone QA 2026-08-23). The sheet is a flex
   column, and at a short detent its children SQUISHED: the tabs crushed toward zero
   and the card title compressed into the sheet edge, which is the half-swallowed
   "Utah County" in his screenshot. Not a scroll bug, a flex-shrink bug, so sticky
   alone could not fix it. Now the header pieces refuse to shrink, the BODY is the
   scroll container (the anatomy every sheet app uses), and the name row with the
   value pins inside it while the kicker and facts scroll under. The X becomes a
   pinned flex child, which also stops it sitting ON the Display tab. */
.hu-sheet-x.gv-x { position:sticky; top:6px; align-self:flex-end;
  margin:0 4px -44px 0; z-index:7; flex:none; }
.gv-tabs { flex:none; margin-right:52px; }
.gv-card-name { position:sticky; top:0; z-index:4; background:var(--face-a); flex:none; }   /* the top of the drawer's face */
/* the body's children hold their natural height; the BODY is what scrolls. Without
   this the card content flex-shrank inside the body and nothing ever overflowed, so
   the "scrolling body" was scrolling three pixels. */
#gvSheetBody > * { flex-shrink:0; }

#gvDisplayBody { overflow-y:auto; min-height:0; flex:1; }
.gv-dsec { border-bottom:1px dotted var(--border); padding:12px 0; }
.gv-dsec:last-child { border-bottom:none; }
/* section headers you can actually read: display face leads, mono meta rides right */
.gv-dsec h5 { display:flex; align-items:baseline; gap:8px; margin:0 0 8px;
  font-family:var(--display); font-size:var(--t-ui); font-weight:800; color:var(--t1); }
.gv-dsec h5 .sub { margin-left:auto; font-family:var(--mono); font-size:var(--t-label); font-weight:400;
  letter-spacing:.08em; text-transform:uppercase; color:var(--t2); }
/* readable sub text drawer-wide (David's call): brighter tier + a size up */
#gvSheet .hu-stat .k { font-size:var(--t-label); color:var(--glass-sub); }   /* a stat tile is glass in both themes */
.gv-drow { display:flex; gap:6px; flex-wrap:wrap; }
.gv-drow .hu-chip i { width:9px; height:9px; border-radius:50%; flex:none; }
.gv-drow .hu-chip .cnt { font-family:var(--mono); font-size:var(--t-label); font-weight:600; color:var(--key-sub); white-space:pre; }   /* the chip is a key */
/* the global .hu-chip.on is a SOLID brass fill (it was teal under The Ink State Rule):
   a colored count on it vanishes, so the count rides the chip's ink */
.gv-drow .hu-chip.on .cnt { color:inherit; }
.gv-tgl { display:flex; justify-content:space-between; align-items:center; padding:6px 2px; font-size:var(--t-fine); color:var(--t2); }
/* the maps' menus (2026-10-08, DECISIONS M1): one Add or Only switch above the chips (the "only" inside every chip
   went), the "?" beside Layers, a map-label row that is one switch, three examples in an empty search */
.gv-pick { display:flex; align-items:center; gap:10px; }
.gv-pick .gv-mode { flex:1 1 auto; }
.gv-help { margin-left:auto; }
.gv-help .hu-gm-q { min-height:36px; width:36px; }
#gvDisplayBody .gv-tgl { width:100%; min-height:44px; border:none; background:none; text-align:left; font:inherit; cursor:pointer; }
#gvDisplayBody .gv-tgl:focus-visible { outline:2px solid var(--teal); outline-offset:2px; border-radius:8px; }
.gv-ex { display:flex; flex-wrap:wrap; gap:6px; padding:14px 6px 12px; }
/* a place's name reads in the same cartographic caps on both maps (the Population Health Map's .lv-name) */
.gv-card-name.place { font-size:var(--t-sub); text-transform:uppercase; letter-spacing:.09em; }
.gv-card-name.place .pv { text-transform:none; letter-spacing:normal; }
@media (max-width:1099px){ #gvSheet .gv-dup { display:none; } }   /* the name row already says the count */
/* desktop has the room: the sheet docks RIGHT as the Inspector panel
   (grammar: docked panel on desktop, detent sheet on phone) */
@media (min-width:1100px){
  /* the drawer tracks the RESIZABLE width (monitor yes, phone no, David's
     call). The FABs left this corner for the bottom-center cluster. */
  #gvSheet { left:auto; right:12px; bottom:12px; top:124px; width:var(--drawer-w, 370px);
    border:1px solid color-mix(in srgb, var(--brass-lo) 50%, var(--border2)); border-radius:14px;
    height:auto; max-height:none; }
  #gvSheet.dt-peek, #gvSheet.dt-half, #gvSheet.dt-full { height:auto; max-height:calc(100dvh - 200px); overflow-y:auto; }
  #gvSheet:not(.open) { transform:translateX(115%); }
  #gvSheet .hu-sheet-grab { display:none; }
  #gvSheet { padding-top:12px; }
  #gvSheet .gv-resize { display:block; position:absolute; left:-4px; top:0; bottom:0; width:9px; cursor:ew-resize; z-index:5; }
  #gvSheet .gv-resize:hover { background:var(--teal); }   /* solid, not a gradient wash */
}
.gv-resize { display:none; }   /* phone/tablet: the sheet owns its width */
/* desktop hover card (fine pointers only) */
.gv-tip { position:absolute; z-index:40; pointer-events:none; display:none; max-width:250px;
  background:var(--face-bg); border:1px solid color-mix(in srgb, var(--brass-lo) 50%, var(--border2)); border-radius:9px; padding:8px 11px;
  box-shadow:var(--panel-lift); }
.gv-tip .tn { font-size:var(--t-fine); font-weight:700; color:var(--t1); line-height:1.3; }
.gv-tip .ts { font-family:var(--mono); font-size:var(--t-label); color:var(--t3); margin-top:3px; }
.gv-tip .ts .st { color:var(--amber); }
[data-theme="light"] .gv-tip .ts .st { color:var(--amber-dk); }

/* ── search takeover ── */
.gv-search { position:fixed; inset:var(--nav-h) 0 auto 0; z-index:340; background:var(--face-bg); border-bottom:1px solid color-mix(in srgb, var(--brass-lo) 50%, var(--border2));
  box-shadow:var(--panel-lift); padding:12px 14px 8px; display:none; flex-direction:column; max-height:calc(100dvh - var(--nav-h)); }
.gv-search.open { display:flex; }
.gv-search-row { display:flex; gap:8px; align-items:center; margin-bottom:6px; }
.gv-search-in { flex:1; height:42px; border-radius:10px; border:1px solid transparent; background:var(--field-bg); box-shadow:var(--field-well); color:var(--field-ink);
  font-family:var(--font); font-size:var(--t-lede); padding:0 14px; }
.gv-search-in::placeholder { color:var(--field-sub); }
.gv-search-in:focus { outline:none; border-color:var(--teal); }
.gv-search-list { overflow-y:auto; min-height:0; padding-bottom:8px; }
.gv-search-list .pop-opt { width:100%; }
/* a school's line ("School · RN · PA · RT · Orem, UT") outgrows a phone row, so the line wraps on its side, never clips */
.gv-sr-meta { margin-left:auto; font-family:var(--mono); font-size:var(--t-label); color:var(--t3); flex:0 1 auto; min-width:0; text-align:right; padding-left:10px; }
.gv-none { font-size:var(--t-sub); line-height:1.45; color:var(--t2); padding:14px 6px; }   /* a sentence, so the sans face (2026-10-08) */

/* ── status chip (above the list pill so they never collide) ── */
.gv-status { position:absolute; bottom:88px; left:50%; transform:translateX(-50%); z-index:20;
  font-family:var(--mono); font-size:var(--t-label); color:var(--field-sub); padding:6px 12px; border-radius:999px; white-space:nowrap;
  background:var(--field-bg); border:1px solid transparent; box-shadow:var(--field-well), 0 6px 14px var(--depth); }
@media (prefers-reduced-motion: no-preference){ .gv-status { transition:opacity .3s; } }
.gv-status.done { opacity:0; pointer-events:none; }
/* tablet: bottom-centre put it on the AK and HI insets (tool review 2026-09-23); lift it clear */
@media (max-width:1099px){ .gv-status { bottom:138px; } }
/* tablet with a card open: the button bar climbs to 150px above the card (below), and the message at 138px sat on
   List, Draw and Locate (phone gate, 2026-10-03, on every link that opens a card). One bar higher clears them.
   Phones are left out: there the message reads under the search row and the bar hides behind an open card. */
@media (min-width:700px) and (max-width:1099px) and (min-height:501px){ .gv-shell:has(#gvSheet.open) .gv-status { bottom:202px; } }

/* ── thumb-zone cluster, bottom center: List pill + draw + locate (David's
   call 2026-07-26, same move as the multi-lens map. The FABs left their
   corner and ride the row in-flow) ── */
.gv-bottombar { position:absolute; bottom:34px; left:50%; transform:translateX(-50%); z-index:110;
  display:flex; gap:8px; align-items:center; }
.gv-bottombar .hu-fab { position:static; width:42px; height:42px; flex:none; }   /* the key's own lift, from hu-global.css */
.gv-listbtn { display:flex; align-items:center; gap:7px; height:42px; padding:0 18px; border-radius:999px; cursor:pointer;
  background:var(--key-bg); border:1px solid transparent; border-top-color:var(--brass-rim); color:var(--key-ink);
  font-family:var(--font); font-size:var(--t-fine); font-weight:700; box-shadow:var(--key-lift); }
.gv-listbtn:hover { color:var(--key-ink); border-color:transparent; border-top-color:var(--brass); filter:brightness(1.08); }
[data-theme="light"] .gv-listbtn:hover { border-top-color:var(--brass-lo); filter:brightness(.97); }
.gv-listbtn:active { transform:translateY(3px); box-shadow:var(--key-down); }
/* .gv-bottombar is absolute at left:50% with no right, so its shrink-to-fit width is
   only half the viewport. Both FABs are flex:none, so the whole squeeze landed here
   and "1,096 in view" wrapped to three lines and clipped at every phone width. */
.gv-listbtn { flex:none; white-space:nowrap; }
.gv-fabcol { display:contents; }   /* invisible on desktop; becomes the phone tool column below */
/* the clear-search control measured 11x18 against the 44px floor */
@media (hover:none){
  #gvPillClr { width:44px; height:44px; }
  .gv-tolist { min-height:44px; }   /* measured 31px against the 44 floor */
}
/* AK/HI insets (item 8): the AlbersUsa answer on a real basemap. Two small
   cameras pinned bottom-left at the national view, click to fly there */
.gv-insets { position:absolute; left:10px; bottom:34px; z-index:20; display:flex; gap:8px; transition:opacity .2s; }
.gv-insets.hide { opacity:0; pointer-events:none; }
.gv-inset { position:relative; width:120px; height:92px; padding:0; border-radius:10px; overflow:hidden; cursor:pointer;
  border:1px solid var(--border); border-top-color:var(--brass-rim); background:var(--face-b); box-shadow:0 3px 0 var(--key-floor), 0 8px 14px var(--depth); }
.gv-inset:hover { border-color:var(--border); border-top-color:var(--brass); }
[data-theme="light"] .gv-inset:hover { border-top-color:var(--brass-lo); }
.gv-inset .gv-inset-map { position:absolute; inset:0; display:block; pointer-events:none; }
.gv-inset b { position:absolute; top:5px; left:7px; z-index:2; font-family:var(--mono); font-size:var(--t-label); font-weight:600;
  color:var(--t1); background:color-mix(in srgb, var(--surface) 88%, transparent); border:1px solid var(--border);
  border-radius:6px; padding:2px 6px; }
.gv-inset b span { color:var(--teal); }
[data-theme="light"] .gv-inset b span { color:var(--teal-ink); }
@media (max-width:699px), (max-height:500px){ .gv-insets { display:none; } }   /* phone portrait already frames AK+HI; GL contexts are precious there */

/* choropleth legend: one small row, bottom-left, only while a tint is on */
.gv-cleg { position:absolute; bottom:34px; left:10px; z-index:20; display:flex; align-items:center; gap:3px;
  padding:5px 9px; border-radius:999px; background:var(--face-bg);
  border:1px solid var(--border); box-shadow:0 6px 14px var(--depth); }
.gv-cleg i { width:14px; height:8px; border-radius:2px; }
.gv-cleg .cl-name { font-family:var(--mono); font-size:var(--t-label); color:var(--t2); margin-right:5px; }
.gv-cleg .cl-dir { font-family:var(--mono); font-size:var(--t-label); color:var(--t3); margin-left:5px; }
.gv-listbtn b { font-family:var(--mono); font-weight:600; font-size:var(--t-label); color:var(--teal); }
[data-theme="light"] .gv-listbtn b { color:var(--teal-ink); }
@media (max-width:699px), (max-height:500px){
  .gv-bottombar .hu-fab { width:46px; height:46px; }
  .gv-listbtn { height:46px; }
  .gv-scope, .gv-pill, .gv-rpill { height:44px; }   /* 44px floor: the search/readout row was 38px (fleet-day parity with multi-lens) */
  .gv-pillwrap .clr { padding:13px 12px; }
  .gv-pill.has-q { padding-right:44px; }
  /* Same restack as multi-lens: the control bar and the info chip both sat INSIDE the
     map-credit band (bar 764-810, chip 790-834, credit 800-844), so the bottom of the
     map read as three things piled on one strip. Give each its own row.
     No .gv-shell ancestor on the attribution: it is a sibling of the shell, not a
     child, and this style block only loads on this page. */
  /* Same one-surface move as the multi-lens dock (design phase 2026-08-23). Three
     separate pills read as clutter however they were spaced. Now: List is the way
     into the data and draws the dock box bottom-left; draw and locate both act ON
     the map, so they share one corner tool column the way every map app stacks its
     zoom controls. Bordered objects at rest: 3 -> 2. */
  .gv-bottombar { bottom:56px; left:10px; right:10px; transform:none;
    justify-content:space-between; align-items:flex-end; }
  /* the tool column is a face with a brass hairline, the kit's phone dock surface (.hu-vdock in hu-global.css) */
  .gv-fabcol { display:flex; flex-direction:column;
    background:var(--face-bg);
    border:1px solid color-mix(in srgb, var(--brass-lo) 45%, var(--border)); border-radius:14px; overflow:hidden;
    box-shadow:var(--panel-lift); }
  .gv-fabcol .hu-fab { background:none; border:none; border-radius:0; box-shadow:none; }
  .gv-fabcol .hu-fab + .hu-fab { border-top:1px solid var(--border); }
  .tool-attribution--fixed { bottom:166px; right:10px; }
  /* the load toast sat at bottom:88px, inside the List pill's band (56-102), so
     "5,366 hospitals · tap a state" rendered THROUGH the button during boot
     (David's phone QA). One row up cleared the List pill but still sat on the draw
     button in the tool column (tool review 2026-09-23). Every control on a phone lives
     at the bottom or in the search row, so it reads just under the search row. */
  .gv-status { top:62px; bottom:auto; }
  /* Parity with multi-lens (David's call: same UI grammar on both maps). One surface
     at a time: when the sheet is up it IS the interface, so the List pill and the
     tool column stop floating over the map behind it. The sheet's X, Esc and the
     hardware back all close it; dismissing brings the cluster back. */
  .gv-shell:has(#gvSheet.open) .gv-bottombar { display:none; }
  main:has(#gvSheet.open) .tool-attribution--fixed { display:none; }
}
/* under 1100px the sheet rises from the bottom. The whole cluster climbs
   above its peek so it never drowns under an open sheet */
@media (max-width:1099px){
  .gv-shell:has(#gvSheet.open) .gv-bottombar { bottom:150px; }
  /* the legend shared bottom:34px with the control bar, which wins on z-index,
     so the worse-to-better key was all but invisible. Lift it clear (twin fix). */
  .gv-cleg { bottom:84px; }
}
.gv-shell .gv-drawfab.is-on { color:var(--amber); border-color:var(--amber); }
[data-theme="light"] .gv-shell .gv-drawfab.is-on { color:var(--amber-dk); border-color:var(--amber-dk); }
/* POS enrichment on pin cards: services as quiet mono chips + a source note */
.gv-svcs { margin-top:12px; }
.gv-svcs-h { font-family:var(--mono); font-size:var(--t-label); letter-spacing:.12em; text-transform:uppercase; color:var(--t3); margin-bottom:6px; }
.gv-svcs-row { display:flex; flex-wrap:wrap; gap:5px; }
.gv-svcs-row i { font-style:normal; font-family:var(--mono); font-size:var(--t-label); color:var(--t2);
  border:1px solid var(--border); border-radius:999px; padding:3px 8px; white-space:nowrap; }
.gv-cardsrc { font-family:var(--mono); font-size:var(--t-label); color:var(--t3); margin-top:12px; line-height:1.5; }
/* cluster rings (2026-10-03, David's pick over plain bubbles): the count on the surface, the slices in the icons' colors */
.gv-ring { pointer-events:none; line-height:0; }
.gv-ring svg { filter:drop-shadow(0 2px 6px rgba(0,0,0,.45)); }
/* a selected school's programs, popped out around it on spokes (2026-10-03): buttons in the programs' own shapes */
.gv-pop { position:relative; width:0; height:0; }
.gv-pop-spokes { position:absolute; left:0; top:0; transform:translate(-50%,-50%); pointer-events:none; overflow:visible; }
.gv-pop-spokes line { stroke:var(--t2); stroke-width:1.5; stroke-opacity:.7; }
.gv-pop-b { position:absolute; width:36px; height:36px; margin:-18px 0 0 -18px; padding:0; border-radius:50%; cursor:pointer;
  display:grid; place-items:center; background:var(--surface); border:1px solid var(--border2); box-shadow:0 4px 12px rgba(0,0,0,.4); }
.gv-pop-b img { width:26px; height:26px; display:block; }
.gv-pop-b:hover, .gv-pop-b:focus-visible { border-color:var(--teal); }
.gv-pop-b.on { border:2px solid var(--amber); }
/* a program on the map but outside the counts (new, or counted at another campus): its icon hollow, its ring dashed */
.gv-pop-b.hollow { border-style:dashed; }
@media (hover:none){ .gv-pop-b { width:44px; height:44px; margin:-22px 0 0 -22px; } }
/* a school's programs and nearest hospitals list in full; the short cap is for scope cards */
.gv-rows.gv-progs { max-height:none; flex:none; margin-top:4px; }
.gv-ring .ring-hole { fill:var(--surface); fill-opacity:.94; }
.gv-ring .ring-n { fill:var(--t1); font-family:var(--font); font-weight:700; font-size:12px; text-anchor:middle; dominant-baseline:central; }
/* a supplier's every CMS category, folded under its supply-type chips (2026-10-03) */
.gv-supall { margin-top:8px; }
.gv-supall summary { cursor:pointer; font-family:var(--mono); font-size:var(--t-label); color:var(--t2); padding:4px 0; }
.gv-supall summary:hover { color:var(--t1); }
.gv-supall ul { margin:6px 0 0; padding-left:18px; font-size:var(--t-label); color:var(--t2); line-height:1.5; }
@media (hover:none){ .gv-supall summary { min-height:44px; display:flex; align-items:center; } }

/* ── the sheet: pin card / county card / state card / list ── */
#gvSheet { padding:0 16px calc(14px + env(safe-area-inset-bottom)); }
/* the drawer's face runs its gradient over a fixed 760px, the desk drawer's height, so a short phone detent shows the
   same top of the face and the sticky name row (--face-a) sits on its own color instead of reading as a band */
#gvSheet { background:linear-gradient(180deg, var(--face-a), var(--face-b)) 0 0 / 100% 760px no-repeat, var(--face-b); }
#gvSheet:not(.open) { transform:translateY(105%); }
/* the desk drawer's top padding: the rule above came after the >=1100 block's padding-top:12px and cut the Details and
   Display strip off at the top of every drawer (2026-10-08). The Population Health Map has the two the right way round. */
@media (min-width:1100px){ #gvSheet { padding-top:12px; } }
/* A CARD AT THE PEEK SHOWS ITS ANSWER: the tabs and the kicker step out of a parked card, as on the Population Health Map */
@media (max-width:1099px){
  #gvSheet.dt-peek .gv-tabs, #gvSheet.dt-peek .gv-card-kicker { display:none; }
  #gvSheet.dt-peek .gv-card-name { padding-right:52px; }
}
@media (max-width:699px), (max-height:500px){
  .gv-tabs button { min-height:44px; }   /* they were 31px */
  .gv-help .hu-gm-q { min-height:44px; width:44px; }
}
/* survey ticks, local copy: .shell-sheet::before is the kit's grabber
   fallback, so the drawer carries its two corner ticks as <i> elements
   (The Survey Tick Rule: 10px arms, border gray, never accent) */
.gv-tick { position:absolute; width:10px; height:10px; pointer-events:none; z-index:2;
  top:5px; left:5px; border-top:1px solid var(--border2); border-left:1px solid var(--border2); }
.gv-tick.b { top:auto; left:auto; bottom:5px; right:5px; border-top:none; border-left:none;
  border-bottom:1px solid var(--border2); border-right:1px solid var(--border2); }
.gv-card-kicker { font-family:var(--mono); font-size:var(--t-label); letter-spacing:.12em; text-transform:uppercase; color:var(--teal); }
[data-theme="light"] .gv-card-kicker { color:var(--teal-ink); }
.gv-card-name { display:flex; align-items:baseline; gap:10px; font-family:var(--display); font-size:17px; font-weight:800; color:var(--t1); line-height:1.15; padding-right:34px; }
/* the peek payoff: the scope count rides the name row where the sheet PARKS
   at peek (<1100). The desktop dock shows the stat tiles already. */
.gv-card-name .pv { display:none; margin-left:auto; flex:none; font-size:var(--t-body); color:var(--teal); }
[data-theme="light"] .gv-card-name .pv { color:var(--teal-ink); }
@media (max-width:1099px){
  /* parity with multi-lens: the parked card carries the answer, and the answer leads.
     Same voice as .hu-stat .v: display face, 800, tabular. */
  .gv-card-name .pv { display:inline; font-size:27px; font-weight:800; font-family:var(--display);
    font-variant-numeric:tabular-nums; line-height:1; }
}
.gv-copylink { margin-top:12px; align-self:flex-start; }
.gv-card-sub { font-family:var(--mono); font-size:var(--t-label); color:var(--t2); margin:3px 0 12px; }
.gv-card-sys { font-size:var(--t-fine); color:var(--t2); margin-top:12px; }
.gv-card-sys b { color:var(--teal); }
[data-theme="light"] .gv-card-sys b { color:var(--teal-ink); }
/* the system name is a door, not a label. Tap-through to the whole footprint */
.gv-syslink { background:none; border:none; padding:0; cursor:pointer; font:inherit; border-bottom:1px dotted var(--teal); }
.gv-syslink:hover b { text-decoration:none; filter:brightness(1.2); }
[data-theme="light"] .gv-syslink { border-bottom-color:var(--teal-dk); }
.gv-card-sys { margin-top:12px; }
.gv-x { position:absolute; top:10px; right:10px; z-index:2; }
.gv-tolist { display:inline-flex; align-items:center; gap:5px; margin-top:14px; padding:7px 12px; border-radius:999px; cursor:pointer;
  background:var(--key-bg); border:1px solid transparent; border-top-color:var(--brass-rim); color:var(--key-ink);
  box-shadow:0 2px 0 var(--key-floor), 0 4px 8px var(--depth); font-family:var(--font); font-size:var(--t-label); font-weight:600; }
.gv-tolist:active { transform:translateY(2px); box-shadow:0 0 0 var(--key-floor), 0 2px 4px var(--depth); }
.gv-list-h { font-family:var(--mono); font-size:var(--t-label); letter-spacing:.1em; text-transform:uppercase; color:var(--t3); padding:2px 0 8px; }
.gv-rows { overflow-y:auto; min-height:0; flex:1; }
.gv-rows.short { flex:none; max-height:190px; margin-top:12px; }
.gv-row { display:block; width:100%; text-align:left; background:none; border:none; border-bottom:1px solid var(--border);
  padding:10px 4px; cursor:pointer; font-family:var(--font); }
.gv-row:hover { background:color-mix(in srgb, var(--teal) 7%, transparent); }
.gv-row .rn { font-size:var(--t-ui); font-weight:700; color:var(--t1); line-height:1.3; }
/* the vitals line: solid ink, the row's answer (Zillow's price-and-beds line) */
.gv-row .rv { font-family:var(--mono); font-size:var(--t-label); font-weight:600; color:var(--t2); margin-top:3px;
  display:flex; flex-wrap:wrap; align-items:baseline; }
.gv-row .rv b { font-weight:400; color:var(--t3); margin:0 6px; }
.gv-row .rv .st { color:var(--amber); }
[data-theme="light"] .gv-row .rv .st { color:var(--amber-dk); }
/* the address line stays quiet under it */
.gv-row .rs { font-family:var(--mono); font-size:var(--t-label); color:var(--t3); margin-top:2px; display:flex; gap:8px; align-items:center; }
.gv-row .rs i { width:8px; height:8px; border-radius:50%; flex:none; }
/* the Schools and Optical dots are near white, so on the light map every dot carries a faint edge to stay visible */
[data-theme="light"] .gv-row .rs i, [data-theme="light"] .gv-drow .hu-chip i { box-shadow:inset 0 0 0 1px rgba(13,17,23,.3); }
.gv-row .rs .st { color:var(--amber); }
[data-theme="light"] .gv-row .rs .st { color:var(--amber-dk); }
.gv-more { font-family:var(--mono); font-size:var(--t-label); color:var(--t3); text-align:center; padding:12px 0 4px; }
.gv-hint { font-family:var(--mono); font-size:var(--t-label); color:var(--t2); margin-top:12px; }
/* fact rows under the stat tiles: label left, value right, two columns */
.gv-facts { display:grid; grid-template-columns:1fr 1fr; gap:5px 18px; margin-top:12px; }
@media (max-width:480px){ .gv-facts { grid-template-columns:1fr; } }
.gv-facts > div { display:flex; justify-content:space-between; align-items:baseline; gap:10px; border-bottom:1px dotted var(--border); padding-bottom:4px; min-width:0; }
/* long facts (names, service lists) take the FULL row. A nowrap value in a
   half-width cell silently shoved its neighbors off the drawer edge
   (David's 07-26 screenshot: Setting/cath/rehab/RT looked empty) */
.gv-facts > div.w { grid-column:1 / -1; }
/* never narrower than its longest word: at 360 a long value squeezed "SPECIALTY" under itself (2026-10-03) */
.gv-facts span { font-family:var(--mono); font-size:var(--t-label); letter-spacing:.12em; text-transform:uppercase; color:var(--t2); min-width:min-content; }   /* mono caption (The Caption Rule, Fog Blue ink) */
/* break-word, NOT anywhere. Anywhere shattered "29" into 2/9 and "Yes" into
   a vertical Y-e-s the moment the drawer got narrow (David's resize test) */
.gv-facts b { font-family:var(--mono); font-size:var(--t-label); color:var(--t1); text-align:right; overflow-wrap:break-word; min-width:0; }
/* the drawer RESIZES on desktop, so the fact grid answers the DRAWER's width,
   not the viewport's: below 480px of sheet, half-cells starve the values,
   collapse to one readable column */
#gvSheet { container-type:inline-size; }
@container (max-width:480px){ .gv-facts { grid-template-columns:1fr; } }
/* MapLibre's attribution chip ships light-only from the CDN css. Theme it */
[data-theme="dark"] .maplibregl-ctrl-attrib { background:color-mix(in srgb, var(--surface) 88%, transparent) !important; }
[data-theme="dark"] .maplibregl-ctrl-attrib, [data-theme="dark"] .maplibregl-ctrl-attrib a { color:var(--t2) !important; }
[data-theme="dark"] .maplibregl-ctrl-attrib-button { filter:invert(1); }
</style>

<noscript><p class="hu-noscript">This tool runs entirely in your browser and needs JavaScript turned on. Nothing you do here is sent to a server.</p></noscript>
<div class="gv-shell">
  <h1 class="vh">{% endraw %}{{ fm.h1 }}{% raw %}</h1>
  <div id="gvMap" role="application" aria-label="{% endraw %}{{ fm.mapLabel }}{% raw %}"></div>

  <div class="gv-top">
    <div class="gv-srow">
      <span class="gv-ident">{% endraw %}{{ fm.ident | safe }}{% raw %}</span>
      <button class="gv-scope" id="gvScope" type="button" hidden>◀ United States</button>
      <span class="gv-pillwrap" style="flex:1;max-width:440px;position:relative;display:flex;min-width:0">
      <button class="gv-pill" id="gvPill" type="button" aria-label="{% endraw %}{{ fm.searchLabel }}{% raw %}" style="flex:1;max-width:none">
        <span aria-hidden="true">⌕</span><span class="q" id="gvPillQ">{% endraw %}{{ fm.pillText }}{% raw %}</span>
      </button>
      <button class="clr" id="gvPillClr" type="button" aria-label="Clear search" title="Clear" style="position:absolute;right:2px;top:50%;transform:translateY(-50%);background:none;border:0;cursor:pointer">✕</button>
      </span>
      <button class="gv-rpill" id="gvLayersPill" type="button" aria-label="Layer filters">Layers</button>
      <button class="gv-rpill" id="gvTypesPill" type="button" aria-label="{% endraw %}{{ fm.typesLabel }}{% raw %}">{% endraw %}{{ fm.typesPill }}{% raw %}</button>
      <button class="gv-rpill" id="gvProgramsPill" type="button" aria-label="School program filters" hidden>Programs</button>
      <button class="gv-rpill" id="gvSuppliesPill" type="button" aria-label="Supply filters" hidden>Supplies</button>
      <button class="gv-rpill gv-dispill" id="gvDisplayPill" type="button" aria-label="Display settings">⚙ <b>Display</b></button>
    </div>
  </div>

  <div class="gv-search" id="gvSearch">
    <div class="gv-search-row">
      <input class="gv-search-in" id="gvSearchIn" type="text" placeholder="{% endraw %}{{ fm.searchPlaceholder }}{% raw %}" autocomplete="off" aria-label="{% endraw %}{{ fm.searchInputLabel }}{% raw %}">
      <button class="icon-btn" id="gvSearchX" type="button" aria-label="Close search">✕</button>
    </div>
    <div class="gv-search-list" id="gvSearchList"></div>
  </div>

  <div class="gv-status" id="gvStatus" role="status">Painting the basemap…</div>
  <div class="gv-insets" id="gvInsets">
    <button class="gv-inset" id="gvInsetAK" type="button" aria-label="Go to Alaska"><span class="gv-inset-map" id="gvInsetAKmap"></span><b>AK <span id="gvInsetAKn"></span></b></button>
    <button class="gv-inset" id="gvInsetHI" type="button" aria-label="Go to Hawaii"><span class="gv-inset-map" id="gvInsetHImap"></span><b>HI <span id="gvInsetHIn"></span></b></button>
  </div>
  <div class="gv-tip" id="gvTip" aria-hidden="true"><div class="tn"></div><div class="ts"></div></div>
  <div class="gv-cleg" id="gvCleg" hidden aria-hidden="true"></div>
  <div class="gv-bottombar">
    <button class="gv-listbtn" id="gvListBtn" type="button" hidden>List <b id="gvCount">·</b></button>
    <div class="gv-fabcol">
    <button class="hu-fab gv-drawfab" id="gvDraw" type="button" aria-label="Draw an area to search" title="Draw an area to search">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 19l7-7 3 3-7 7-3-3z"></path><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path><path d="M2 2l7.586 7.586"></path><circle cx="11" cy="11" r="2"></circle></svg>
    </button>
    <button class="hu-fab" id="gvLocate" type="button" aria-label="Show my location on the map" title="My location">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="3"></circle><path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path><circle cx="12" cy="12" r="8"></circle>
      </svg>
    </button>
    </div>
  </div>

  <aside class="shell-sheet" id="gvSheet" aria-label="Detail">
    <i class="gv-tick" aria-hidden="true"></i><i class="gv-tick b" aria-hidden="true"></i>
    <button class="icon-btn hu-sheet-x gv-x" id="gvSheetX" type="button" aria-label="Close">✕</button>
    <div class="gv-tabs" id="gvTabs" role="tablist">
      <button type="button" data-tab="details" class="on" role="tab" aria-selected="true">Details</button>
      <button type="button" data-tab="display" role="tab" aria-selected="false">Display</button>
    </div>
    <div id="gvSheetBody" style="display:flex;flex-direction:column;min-height:0;flex:1;overflow-y:auto"></div>
    <div id="gvDisplayBody" hidden></div>
  </aside>
  <div id="gvLive" aria-live="polite" aria-atomic="true" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap"></div>
</div>

