{# ── KEEP READING · the reading handoff (reading phase, 2026-08-24) ──
   An 11-minute read used to end in the site footer. Learn hands off along the
   authored readingOrder in _data/learn.js; Rounds walks posted order (both
   computed in the data files, where the logic is plain JS instead of
   loop-scoped Nunjucks sets). The last stop, or any page missing from the
   order, offers the section index alone. #}
{% if section == 'learn' %}
  {% set rn = learn.nextByUrl[page.url] %}
  {% set rnAllUrl = '/learn/' %}{% set rnAllLabel = 'All Learn modules' %}
{% else %}
  {% set rn = rounds.nextByUrl[page.url] %}
  {% set rnAllUrl = '/rounds/' %}{% set rnAllLabel = 'All Rounds' %}
{% endif %}
<aside class="read-next" aria-label="Keep reading">
  {% if rn %}
  <a class="rn-card" href="{{ rn.url }}">
    <span class="rn-k">{{ rn.kick }}</span>
    <span class="rn-t">{{ rn.title }}</span>
    <span class="rn-d">{{ rn.desc }}</span>
  </a>
  {% endif %}
  <div class="rn-row">
    <a class="rn-all" href="{{ rnAllUrl }}">{{ rnAllLabel }} &rarr;</a>
    {# unhidden by reading.js only when the browser can share or copy #}
    <button type="button" class="rn-share" id="rn-share" hidden>Share this</button>
    <span class="rn-shared" id="rn-shared" hidden>Link copied</span>
  </div>
</aside>
