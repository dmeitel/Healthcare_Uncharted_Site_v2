{#- THE DEV BLOG's own pieces (2026-10-11): the post list, the feedback tracker and the timeline. Everything else is the
    .hu-read shell in hu-global.css. Included once by the blog's front page and by every post. -#}
<style>
  .blog .hu-read-h1 { font-size:clamp(36px,5.6vw,64px); }
  .blog-by { display:flex; flex-wrap:wrap; gap:6px 16px; margin-top:16px; font-family:var(--mono); font-size:var(--t-label); color:var(--t3); }
  .blog-by strong { color:var(--t2); font-weight:600; }
  /* the way back to every post is the eyebrow itself, not a closing line (his note, 2026-10-12: no little one-liners) */
  .hu-read a.blog-up { display:inline-flex; align-items:center; min-height:44px; color:inherit; text-decoration:underline; text-underline-offset:3px; text-decoration-thickness:1px; }
  .hu-read a.blog-up:hover { text-decoration-thickness:2px; }
  .blog-up:focus-visible { outline:2px solid var(--teal); outline-offset:3px; border-radius:4px; }
  [data-theme="light"] .blog-up:focus-visible { outline-color:var(--teal-dk); }

  /* the post list on the front page: each post a framed face */
  .blog-list { list-style:none; margin:0; padding:0; display:grid; gap:14px; max-width:820px; }
  .blog-post { display:block; padding:18px 20px 16px; border-radius:12px; text-decoration:none;
    background:var(--face-bg); border:1px solid var(--border); box-shadow:var(--panel-lift); }
  .hu-read a.blog-post { color:inherit; }
  .blog-post:hover { border-color:var(--brass-lo); }
  .blog-post:focus-visible { outline:2px solid var(--teal); outline-offset:3px; }
  [data-theme="light"] .blog-post:focus-visible { outline-color:var(--teal-dk); }
  .blog-post .k { display:block; font-family:var(--mono); font-size:var(--t-label); letter-spacing:.14em; text-transform:uppercase; color:var(--t3); margin-bottom:6px; }
  .blog-post .t { display:block; font-family:var(--display); font-size:clamp(20px,2.4vw,26px); font-weight:700; line-height:1.2; color:var(--t1); margin-bottom:6px; }
  .blog-post .d { display:block; font-size:var(--t-sub); line-height:1.6; color:var(--t2); }
  /* a post's figures row keeps to the width the post list keeps; across the whole body it ran 214px past the prose on a desk */
  .blog .hu-stats { max-width:820px; }

  /* the feedback tracker: one row per note, its status in words as well as color */
  .blog-tally { display:flex; flex-wrap:wrap; gap:8px; margin:0 0 16px; padding:0; list-style:none; }
  .blog-tally li { font-family:var(--mono); font-size:var(--t-label); color:var(--t2); padding:6px 12px; border-radius:999px; border:1px solid var(--border2); }
  .blog-tally b { color:var(--t1); font-weight:700; margin-right:4px; }
  .blog-fb { list-style:none; margin:0; padding:0; max-width:900px; border-top:1px solid var(--border); }
  .blog-fb li { display:grid; grid-template-columns:110px minmax(0,1fr); gap:4px 16px; padding:14px 0; border-bottom:1px solid var(--border); }
  .blog-fb .st { grid-row:span 2; align-self:start; justify-self:start; font-family:var(--mono); font-size:var(--t-label); font-weight:700;
    letter-spacing:.06em; text-transform:uppercase; padding:4px 10px; border-radius:999px; border:1px solid currentColor; white-space:nowrap; }
  .blog-fb .st.done { color:var(--green); } .blog-fb .st.planned { color:var(--amber); } .blog-fb .st.not { color:var(--t3); }
  [data-theme="light"] .blog-fb .st.done { color:var(--green-dk); } [data-theme="light"] .blog-fb .st.planned { color:var(--amber-dk); }
  .blog-fb .h { font-size:var(--t-sub); line-height:1.55; color:var(--t1); margin:0; }
  .blog-fb .w { font-size:var(--t-sub); line-height:1.55; color:var(--t2); margin:0; }
  .blog-fb .w small { display:block; font-family:var(--mono); font-size:var(--t-label); color:var(--t3); margin-top:3px; }
  .blog-fb .w small a { color:inherit; white-space:nowrap; }   /* "post 1" broke at its space on a phone and left the 1 alone on a line */

  /* the timeline in a post: a rail with a dot per milestone */
  .blog-tl { list-style:none; margin:8px 0 22px; padding:0 0 0 22px; max-width:760px; position:relative; }
  .blog-tl::before { content:''; position:absolute; left:6px; top:6px; bottom:6px; width:2px; border-radius:2px; background:var(--border2); }
  .blog-tl li { position:relative; padding:0 0 14px 8px; font-size:var(--t-sub); line-height:1.55; color:var(--t2); }
  .blog-tl li::before { content:''; position:absolute; left:-21px; top:6px; width:10px; height:10px; border-radius:50%;
    background:var(--face-bg); border:2px solid var(--brass-lo); }
  .blog-tl li.big::before { background:var(--brass); border-color:var(--brass); }
  .blog-tl time { display:block; font-family:var(--mono); font-size:var(--t-label); letter-spacing:.1em; text-transform:uppercase; color:var(--t3); }
  .blog-tl b { color:var(--t1); font-weight:600; }

  @media (max-width:699px), (max-height:500px) {
    .blog-fb li { grid-template-columns:minmax(0,1fr); }
    .blog-fb .st { grid-row:auto; margin-bottom:4px; }
    .blog-post { padding:16px; }
  }
</style>
