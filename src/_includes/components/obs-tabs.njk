{#- The Data Observatory's two tabs on the site. Each tab is its own page, so this is a nav of
    links with the current one marked, not a widget. Styles: /assets/css/observatory.css.
    The comment at the end is a marker: the hub's server (scripts/review.js, David's computer only)
    swaps it for a link back to the hub. On the live site it stays a comment. -#}
{%- set obsTabs = [
  { id: 'data', label: 'Data map', href: '/secret-menu/data-observatory/' },
  { id: 'traffic', label: 'Traffic', href: '/secret-menu/data-observatory/traffic/' }
] -%}
<nav class="obs-tabs" aria-label="Data Observatory">
  {%- for t in obsTabs %}
  <a class="toggle-chip{% if obsTab == t.id %} on{% endif %}" href="{{ t.href }}"{% if obsTab == t.id %} aria-current="page"{% endif %}>{{ t.label }}</a>
  {%- endfor %}
  <!--hub-link-->
</nav>
