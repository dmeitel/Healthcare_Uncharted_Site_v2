{#- THE AUTHOR CARD (2026-10-11, AB2 "go with A"): one card, the same parts for every author, from src/_data/authors.js.
    Set `au` before including. The name is an h3 under the page's Authors heading. On a phone the photo shrinks beside the
    name and the topic tags hide; the second half of the bio is behind a fold everywhere. -#}
<article class="au" id="{{ au.id }}">
  <div class="au-h">
    <div class="au-ph"><img src="{{ au.photo }}" alt="{{ au.name }}" width="{{ au.photoW }}" height="{{ au.photoH }}" loading="lazy" decoding="async"></div>
    <div>
      <h3 class="au-n">{{ au.name }}</h3>
      <div class="au-c">{{ au.creds }}</div>
      <div class="au-r">{{ au.role }}</div>
    </div>
  </div>
  {%- if au.tags and au.tags.length %}
  <div class="au-tags">{% for t in au.tags %}<span class="au-tag">{{ t | safe }}</span>{% endfor %}</div>
  {%- endif %}
  {%- for p in au.bio %}
  <p>{{ p | safe }}</p>
  {%- endfor %}
  {%- if au.more.length or au.credentials.length or au.moreAfter.length %}
  <details class="hu-fold au-more">
    <summary>More about {{ au.name.split(' ')[0] }}</summary>
    {%- for p in au.more %}
    <p>{{ p | safe }}</p>
    {%- endfor %}
    {%- if au.credentials.length %}
    <div class="credentials-grid">
      {%- for c in au.credentials %}
      <div class="hu-stat"><div class="cred-abbr">{{ c.abbr }}</div><div class="cred-full">{{ c.full | safe }}</div></div>
      {%- endfor %}
    </div>
    {%- endif %}
    {%- for p in au.moreAfter %}
    <p>{{ p | safe }}</p>
    {%- endfor %}
  </details>
  {%- endif %}
  {%- if au.works.length %}
  <div class="au-w">
    <div class="au-wl">Written for Healthcare Uncharted</div>
    {%- for w in au.works %}
    <a class="au-work" href="{{ w.href }}">
      <div class="au-work-t">{{ w.title | safe }} &rarr;</div>
      <div class="au-work-m">{{ w.meta | safe }}</div>
    </a>
    {%- endfor %}
  </div>
  {%- endif %}
  <div class="au-acts">
    {%- if au.linkedin %}
    <a class="linkedin-btn" href="{{ au.linkedin }}" target="_blank" rel="noopener">
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      Connect on LinkedIn
    </a>
    {%- endif %}
    {%- if au.card %}
    <a class="hu-key" href="{{ au.card }}">My card, to share</a>
    {%- endif %}
  </div>
</article>
