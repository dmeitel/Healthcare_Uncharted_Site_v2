{# Compact attribution strip for interactive tools.
   Usage:
     {% set ta_fixed = true %}          — optional, floats bottom-right
     {% set ta_source = 'CMS Provider Data · 2024' %}  — optional source line
     {% set ta_source_href = '/learn/healthcare-data-sources/' %} — optional link target
     {% include "components/tool-attribution.njk" %}
   Phone (≤699px): the FIXED variant collapses to an ⓘ chip — the full card
   was burying the thumb-zone controls (year pill, FABs, legend) on the maps.
   Tap ⓘ to read, tap ✕ to put it away. Inline (non-fixed) usage is untouched. #}
<div class="tool-attribution{% if ta_fixed %} tool-attribution--fixed{% endif %}">
  {% if ta_fixed %}<button class="ta-toggle" type="button" aria-expanded="false" aria-label="Data sources and disclaimer">ⓘ</button>{% endif %}
  {# THE LIST (2026-10-16): every piece is an item, and hu-global.css (.ta-list) draws the dot before each item after
     the first, so a dot never starts or ends a line. A source line's own " · " pieces are items too. #}
  <span class="ta-list">
  <span class="ta-brand">Healthcare <span>Uncharted</span></span>
  <span>Educational use, not clinical advice</span>
  {% if ta_source %}
  {% if ta_source_href %}<span><a href="{{ ta_source_href }}">{{ ta_source }}</a></span>{% else %}{% for part in ta_source.split(' · ') %}<span>{{ part }}</span>{% endfor %}{% endif %}
  {% endif %}
  {# Support. Rides the strip's existing separator grammar rather than adding
     floating chrome, because a tool is an instrument and a donation ask should
     not compete with its controls. On the FIXED variant it lives behind the ⓘ
     with the rest of the card, so it never sits on the thumb zone. #}
  {% if site.support.url %}
  <span><a href="{{ site.support.url }}" target="_blank" rel="noopener">{{ site.support.short }}</a></span>
  {% endif %}
  </span>
</div>
{% if ta_fixed %}
<script>
(function(){
  /* Esc and the phone's back gesture close the card too (2026-10-08, the maps' menus review: on a phone the back
     gesture left the tool instead). Esc is heard first and goes no further, so one press is one step back. */
  document.querySelectorAll('.tool-attribution--fixed .ta-toggle:not([data-wired])').forEach(function(b){
    b.setAttribute('data-wired', '1');
    var box = b.closest('.tool-attribution');
    function set(open){
      box.classList.toggle('ta-open', open);
      b.setAttribute('aria-expanded', open ? 'true' : 'false');
      b.textContent = open ? '✕' : 'ⓘ';
    }
    b.addEventListener('click', function(){ set(!box.classList.contains('ta-open')); });
    window.addEventListener('keydown', function(e){
      if (e.key !== 'Escape' || !box.classList.contains('ta-open')) return;
      e.stopPropagation(); set(false); b.focus();
    }, true);
    /* this card rides on pages that load the kit later or not at all, so it reaches the kit through window, and only
       once the kit is there (the page's load event at the latest) */
    function guard(){
      var kit = window.HUKit;
      if (!kit || !kit.backGuard) return false;
      kit.backGuard({ watch: box, cls: 'ta-open', active: function(){ return box.classList.contains('ta-open'); }, step: function(){ set(false); } });
      return true;
    }
    if (!guard()) window.addEventListener('load', guard, { once: true });
  });
})();
</script>
{% endif %}
