{#- THE FEEDBACK TRACKER (2026-10-11): the notes a post heard and what came of each, from src/_data/devBlog.js.
    Set `fbRows` before including; set `fbLinkPosts` to name the post each row came from (the front page does). -#}
<ul class="blog-fb">
  {%- for f in fbRows %}
  <li>
    <span class="st {{ f.status }}">{{ devBlog.STATUS[f.status] }}</span>
    <p class="h">{{ f.heard }}</p>
    <p class="w">{{ f.did }}<small>{{ f.from }}{% if f.when %} · done {{ f.when }}{% endif %}{% if fbLinkPosts %} · <a href="/secret-menu/blog/{{ f.post }}/">post {{ f.postN }}</a>{% endif %}</small></p>
  </li>
  {%- endfor %}
</ul>
