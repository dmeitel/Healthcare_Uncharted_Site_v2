{
 "_meta": {
  "written": "2026-10-20",
  "note": "What each FDA class (Established Pharmacologic Class, from NLM RxClass) is called on a Daily Huddle tile: the name a clinician says. Hand-written for DECISIONS DH13; David reads it before it ships. scripts/huddle/feeds/drug-classes.js reads it with scripts/data/huddle-drug-classes.json.",
  "fields": "name: the answer as a tile shows it. area: wrong answers come from the same area where it has enough. group: names for nearly the same thing (a thiazide and a thiazide-like diuretic) never share a question. broad: an umbrella name (antiarrhythmic, antiemetic) that many drugs could be called, so it can be a right answer but never a wrong one. an: takes \"an\". skip: no tile for that class."
 },
 "skipDrugs": {
  "trazodone": "The FDA class reads Serotonin Reuptake Inhibitor, and a tile would call it an SSRI, which clinicians do not.",
  "carbamazepine": "The FDA class reads Mood Stabilizer; clinicians know it first as an antiepileptic, so either answer reads as a trick.",
  "penicillin v": "Its class is in its name."
 },
