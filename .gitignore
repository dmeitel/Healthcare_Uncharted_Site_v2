# Build cache — large CMS source files fetched by scripts/build-suppliers.js
scripts/.cache/

# Dependencies. Netlify reinstalls these on every deploy via `npm install`,
# so committing them is pure bloat and drags every dependency vuln into history.
node_modules/

# Build output. Netlify regenerates this from source on every deploy.
_site/
build-output.txt

# Secrets. Never commit these. The day a key exists, this line is what stops it.
.env
.env.*
!.env.example

# Local Netlify folder
.netlify

# Mobile-test artifacts: headless browser console logs and QA screenshots.
# Regenerated by every hu-mobile-tester run, so committing them is churn.
.playwright-mcp/
tmp/

# Third-party agent skills (Emil Kowalski's set, installed via
# `npx skills@latest add emilkowalski/skills`). The installer writes real files to
# .agents/skills/ and symlinks them into .claude/skills/. Vendoring both would
# duplicate the tree and commit Windows-fragile symlinks, so each machine installs
# its own. Our OWN skills (hu-voice, impeccable) stay tracked.
.agents/
.claude/skills/animate/
.claude/skills/animate-expo/
.claude/skills/animation-vocabulary/
.claude/skills/apple-design/
.claude/skills/ask-sonner/
.claude/skills/emil-design-eng/
.claude/skills/find-animation-opportunities/
.claude/skills/improve-animations/
.claude/skills/pick-ui-library/
.claude/skills/prototype/
.claude/skills/review-animations/
.claude/skills/write-swift/
