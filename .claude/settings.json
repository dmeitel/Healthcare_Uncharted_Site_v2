{
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000"
  },
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm run build:*)",
      "Bash(npm run check:*)",
      "Bash(npm run phone:*)",
      "Bash(npm run build)",
      "Bash(npm run check)",
      "Bash(npm run phone)",
      "Bash(npm test)",
      "Bash(npx @11ty/eleventy:*)",
      "Bash(node scripts/:*)",
      "Bash(node --check:*)",
      "Bash(node --test:*)",
      "Bash(tsc --noEmit:*)",

      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(git blame:*)",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(du:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sed -n:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(awk:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",

      "WebFetch(domain:www.manatt.com)",
      "WebFetch(domain:www.nature.com)",
      "WebFetch(domain:www.healthaffairs.org)",
      "WebFetch(domain:pmc.ncbi.nlm.nih.gov)",
      "WebFetch(domain:www.ahrq.gov)",
      "WebFetch(domain:www.kff.org)",
      "WebFetch(domain:www.cdc.gov)",
      "WebFetch(domain:data.cms.gov)",
      "WebFetch(domain:www.cms.gov)",
      "WebFetch(domain:aspe.hhs.gov)",
      "WebFetch(domain:www.census.gov)",
      "WebFetch(domain:www.bls.gov)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git reset --hard:*)",
      "Bash(npm publish:*)"
    ]
  }
}
