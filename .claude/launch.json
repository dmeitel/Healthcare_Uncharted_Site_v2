{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hu-site",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "process.argv=[process.argv[0],'eleventy','--serve','--port='+(process.env.PORT||'8080')];require('./node_modules/@11ty/eleventy/cmd.cjs')"],
      "port": 8080,
      "autoPort": true
    },
    {
      "name": "hu-site-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["@11ty/eleventy", "--serve", "--port=8086"],
      "port": 8086
    },
    {
      "name": "hu-review",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "process.env.REVIEW_PORT=process.env.PORT||'8082';require('./scripts/review.js')"],
      "port": 8082,
      "autoPort": true
    }
  ]
}
