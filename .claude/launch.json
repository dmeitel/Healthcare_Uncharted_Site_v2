{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hu-site",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["@11ty/eleventy", "--serve"],
      "port": 8080
    },
    {
      "name": "hu-site-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["@11ty/eleventy", "--serve", "--port=8086"],
      "port": 8086
    },
    {
      "name": "hu-review",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "process.env.REVIEW_PORT=process.env.PORT||'8082';require('./scripts/review.js')"],
      "port": 8082,
      "autoPort": true
    }
  ]
}
